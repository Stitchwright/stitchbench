{
  "name": "stitchbench",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/data/fetch-reference-data.mjs",
    "build": "prisma generate && next build",
    "start": "npm run release && next start",
    "release": "prisma migrate deploy && tsx prisma/seed.ts --if-empty",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "e2e": "playwright test",
    "test:unit": "tsx --conditions=react-server --test \"src/**/*.test.ts\" \"tests/unit/*.test.ts\"",
    "e2e:setup": "tsx scripts/e2e-setup.ts",
    "license": "tsx scripts/license/issue.ts",
    "license:keygen": "tsx scripts/license/keygen.ts",
    "check": "tsx --conditions=react-server",
    "demo:reset": "tsx --conditions=react-server scripts/demo/reset.ts",
    "foundry:retire-passwords": "tsx --conditions=react-server scripts/foundry/retire-passwords.ts",
    "foundry:owner-link": "tsx --conditions=react-server scripts/foundry/owner-link.ts",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "mail:sink": "node scripts/test-mail/smtp-sink.mjs",
    "sms:mock": "node scripts/test-mail/twilio-mock.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.62.0",
    "modern-screenshot": "4.7.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "railway": "^3.16.0",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
