# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Python's compiled files (scripts/library, scripts/hub)
__pycache__/

# license signing keys: the private halves stay out of the repo (scripts/license/keygen.ts refuses an --out inside it);
# the development key is committed on purpose (modules-design.md section 3.3)
/scripts/license/*.pem
!/scripts/license/dev-key.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client
/src/generated
!.env.example

# The manufacturers' reference data, read out of OEM manuals: it lives in a private repository, not in the public code
# (INSTALL.md, "The manufacturers' reference data"). scripts/data/fetch-reference-data.mjs downloads it for official
# builds; ignored so a copy fetched into a clone of the public code is never committed there. Already tracked: stays.
/prisma/seed-data/factory_settings.json
/prisma/seed-data/tension_specs.json
/prisma/seed-data/library_docs.json
/prisma/seed-data/hub_links.json
/prisma/seed-data/.*.part

# playwright
/test-results
/playwright-report
/public/pdf.worker.min.mjs
desktop/node_modules/
desktop/server/
desktop/dist/
desktop/dist-stitchshop/
/public/pdfjs/

# local scratch runs (scripts/local-test, sanity scripts)
/.run/

# the demo seed's guest (a real person the demo is shown to): local only
scripts/demo/*.local.json

# deep-research working notes and reports (the finished report is copied into docs/research/)
/research_notes/
/reports/
