{
  "name": "stitchbench-desktop",
  "productName": "StitchBench",
  "version": "1.7.1",
  "description": "StitchBench (repair bench) or StitchShop (sewing / quilt shop counter) for the shop PC: runs the app and its database, and serves it to every device on the shop network.",
  "author": "Timing & Tension",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "prepare-app": "node prepare-app.mjs",
    "start": "electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "installer": "electron-builder --win nsis --publish never",
    "installer:stitchshop": "electron-builder --win nsis --publish never -c.extraMetadata.flavor=stitchshop -c.extraMetadata.productName=StitchShop -c.productName=StitchShop -c.appId=com.timingandtension.stitchshop -c.nsis.shortcutName=StitchShop -c.directories.output=dist-stitchshop",
    "dist": "node prepare-app.mjs && npm run installer",
    "dist:stitchshop": "node prepare-app.mjs && npm run installer:stitchshop"
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.timingandtension.stitchbench",
    "productName": "StitchBench",
    "asar": false,
    "directories": {
      "output": "dist",
      "app": "."
    },
    "files": [
      "main.mjs",
      "migrate.mjs",
      "backup.mjs",
      "reference.mjs",
      "app-role.mjs",
      "links-gate.mjs",
      "tailscale.mjs",
      "reset-password.mjs",
      "update.mjs",
      "release-key.mjs",
      "icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "StitchBench"
    }
  }
}
