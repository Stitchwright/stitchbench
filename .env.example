# Postgres connection string (docker compose up -d gives you this one locally)
DATABASE_URL="postgresql://stitchbench:stitchbench@localhost:5433/stitchbench"
# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=""
# Owner account created by `npm run db:seed`
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Shop Owner"
SEED_SHOP_NAME="My Repair Shop"
# Leave empty to have the seed print a random password
SEED_OWNER_PASSWORD=""
# Set to "true" to let new repair shops create their own account at /signup
ALLOW_SIGNUP="false"
# Comma-separated emails of whoever runs StitchBench itself: they see Companies and can add other shops
PLATFORM_ADMIN_EMAILS=
# "true" loads prisma/seed-data/library_docs.json (one shop's own manual-library listing); leave empty for other shops
SEED_LIBRARY=
# Hosted app only: the hosting key that signs the Companies page's module switch, as the base64 printed by `npm run license:keygen -- --kid h1 --hosted` (its presence also turns test keys off)
LICENSE_HOSTED_KEY=
# Hosted app only: which line of src/lib/license-keys.ts that key is (default h1)
LICENSE_HOSTED_KID=
# Messages: "off" stops every send path (the timer, "Send now", test sends); leave empty on a real install
MESSAGES=
# How often the message worker runs, in seconds (default 30; tests use 2-5)
MESSAGE_WORKER_SECONDS=
# Messages per shop, per channel, per worker run (default 20)
MESSAGE_BATCH=
# Seconds a ready-for-pickup notice waits before going out, the undo window (default 120)
READY_NOTICE_DELAY_SECONDS=
# The public https address customers' links open (estimate approval, one-click unsubscribe); hosted: set by the operator, Windows program: from config.json publicUrl
PUBLIC_URL=
# "true": requests whose Host is PUBLIC_URL's host get only the public pages (always true on the Windows program when publicUrl is set)
PUBLIC_LINKS_ONLY=
# Key material that seals the mail password and Twilio secret at rest (default AUTH_SECRET; required on a hosted production build)
SETTINGS_KEY=
# The previous SETTINGS_KEY while rotating keys: read only, values are re-sealed with the new key
SETTINGS_KEY_PREVIOUS=
# Comma-separated host:port list allowed as a private or plain mail server under hosted rules (tests: the SMTP sink's address)
SMTP_ALLOW_HOSTS=
# Hosted only: this site's own https address, for the password links it mails or hands out (default PUBLIC_URL unless
# PUBLIC_LINKS_ONLY, then Railway's public domain)
APP_URL=
# Hosted only: the mailbox "Forgot your password?" sends from (smtps://user:pass@host:465, or smtp://...:587 for STARTTLS) and
# its From address. Without them the Companies page makes an owner's reset link by hand
PLATFORM_SMTP_URL=
PLATFORM_MAIL_FROM=
# Hosted only: 32+ random characters, the same on StitchHub; lets the hub's "Start a hosted shop" make companies here
# (POST /api/platform/companies). Unset: the route doesn't exist
PLATFORM_API_TOKEN=
# Tests only: the Twilio mock's address instead of https://api.twilio.com
TWILIO_API_BASE=
# "true" behind a proxy such as Railway's: clientAddress() then reads the last X-Forwarded-For hop
TRUST_PROXY=
# The Foundry Account service (sign-in and AI paid in Foundry credits). Empty = https://cloud.stitchfoundry.app. Tests point it at scripts/test-mail/foundry-mock.mjs.
FOUNDRY_CLOUD_URL=
# Hosted only: signing in with a Foundry Account (docs/plan.md FA-2). Unset/"off" = as before; "on" = the Foundry Account beside the old
# email and password; "only" = the old password no longer signs anyone in (everyone signs in again with their Foundry Account)
FOUNDRY_SIGNIN=
