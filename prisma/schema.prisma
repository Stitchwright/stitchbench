// StitchBench — sewing / embroidery / longarm machine repair bench.
// One Shop = one repair business. Every business row carries shopId; the
// tension-spec reference table is shared by all shops (facts from OEM manuals).
// Money is stored in integer cents.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Shops and users
// ============================================================

enum Role {
  OWNER
  ADMIN
  TECH
}

model Shop {
  id                       String        @id @default(cuid())
  name                     String
  phone                    String?
  email                    String?
  address                  String?
  laborRateCents           Int           @default(9800)
  taxRatePct               Float         @default(0)
  partsMarkupPct           Float         @default(30)
  // Fabric (fabric-smarts-design.md section 9): fat quarter price = yard price / 4 x (1 + this %), a half yard =
  // yard price / 2 x (1 + this %), a remnant sells at this % of the yard price (never under cost x 1.05), and a bolt
  // end is this many yards or fewer.
  fatQuarterMarkupPct      Float         @default(15)
  halfYardMarkupPct        Float         @default(10)
  remnantPricePct          Float         @default(50)
  boltEndYards             Float         @default(1)
  // Fabric insight (fabric-smarts-design.md sections 2 and 9; docs/research/fabric-analytics-methods.md): every threshold
  // of What sells, Slow fabric and the markdown ladder. Days, percents and cents; the floor is a percent of cost.
  fabVelocityWeeks         Int           @default(12)
  fabEarlyDays             Int           @default(21)
  fabBlendDays             Int           @default(42)
  fabUnratedDays           Int           @default(42)
  fabWatchDays             Int           @default(90)
  fabWatchWeeks            Int           @default(26)
  fabMarkdownDays          Int           @default(120)
  fabClearanceDays         Int           @default(180)
  fabMarkdownSoldPct       Int           @default(60)
  fabStep1Pct              Int           @default(20)
  fabStep2Pct              Int           @default(35)
  fabStep3Pct              Int           @default(50)
  fabFloorPct              Int           @default(105)
  fabCutCostCents          Int           @default(50)
  fabAbcAPct               Int           @default(80)
  fabAbcBPct               Int           @default(95)
  fabGmroiGood             Float         @default(3)
  fabGmroiReview           Float         @default(1.5)
  // Fabric ordering (package F3): the review period in weeks, the safety-stock z for collections (90%) and staples (95%),
  // the lead time in days for a supplier with no received order yet, and "Reorder now" (this percent of the lot sold in
  // this many days, and the weeks of supply under lead time plus this many weeks).
  fabReviewWeeks           Int           @default(2)
  fabZCollection           Float         @default(1.28)
  fabZStaple               Float         @default(1.65)
  fabLeadDays              Int           @default(14)
  fabUrgentSoldPct         Int           @default(60)
  fabUrgentDays            Int           @default(28)
  fabUrgentWeeks           Int           @default(2)
  // Kits (package F4): the margin a kit price aims for (percent of the price) and the bundle discount off the parts' shelf prices.
  fabKitMarginPct          Int           @default(50)
  fabBundleDiscountPct     Int           @default(5)
  warrantyDays             Int           @default(90)
  abandonedAfterDays       Int           @default(60)
  storageFeeCents          Int           @default(4500)
  nextTicketNumber         Int           @default(51)
  // Where the shop keeps its manual library on every PC (links show this path)
  libraryRoot              String        @default("C:\\Manuals")
  // Service checklist template, one item per line of work (edited in Settings)
  checklistItems           String[]
  // Fine print at the bottom of the printed price list
  priceListNote            String?
  // How other shops pay this one for marketplace orders (PayPal, Zelle, check to...)
  payInstructions          String?
  // Send the hub this company's monthly parts counts for the community's most-used list (counts only; off unless turned on)
  shareUsage               Boolean       @default(false)
  // What this company does: a repair bench (StitchBench), a sewing / quilt shop counter (StitchShop), or both
  doesRepair               Boolean       @default(true)
  sellsRetail              Boolean       @default(false)
  nextSaleNumber           Int           @default(1001)
  nextLongarmNumber        Int           @default(1)
  // Print and cut jobs (shop-features-round-2-design.md 6.5, Maker Shop): the next job number, the machine's hourly rate,
  // the set-up fee, and the materials the laser never cuts (PVC and vinyl give off chlorine gas when laser cut).
  nextMakeJobNumber        Int           @default(1)
  makeRateCents            Int           @default(2000)
  makeSetupCents           Int           @default(500)
  makeNeverCut             String        @default("PVC, vinyl")
  // Warranty claims to makers (shop-features-round-2-design.md 9.1): the next claim's number
  nextClaimNumber          Int           @default(1)
  // Co-op advertising and rebate claims (9.2): the next one's number
  nextCoopNumber           Int           @default(1)
  // Customers' machines on consignment (9.6): the shop's commission when none is typed, a percent of what it sells for
  consignDefaultPct        Float         @default(25)
  // Quilt appraisals (9.8): the next certificate's number, the usual fee, and the appraiser's name and credential
  nextAppraisalNumber      Int           @default(1)
  appraisalFeeCents        Int           @default(7500)
  appraiserName            String?
  appraiserCredential      String?
  // House charge accounts (9.4): off until the owner turns them on
  houseAccountsOn          Boolean       @default(false)
  // The card reader at the counter (4.8): Stripe Terminal on the shop's own Stripe account (its key is stripeKeySealed),
  // off until turned on; the Terminal location the readers are registered to
  cardReaderOn             Boolean       @default(false)
  terminalLocationId       String?
  // Shipping labels through Shippo (9.5): off until turned on; the shop's own Shippo API key (sealed), where parcels ship
  // from { name, street1, city, state, zip, phone } and the usual box { lengthIn, widthIn, heightIn, weightOz }
  shippoOn                 Boolean       @default(false)
  shippoKeySealed          String?
  shipFrom                 Json          @default("{}")
  // More than one store (7.1-7.5): the store whose shelves the online shop and the product feeds sell from (a Location
  // id; null = the main store), the next transfer's number, and the owner's daily summary at each store's closing time
  // (on unless turned off; sent only with more than one store), by "email" or "text".
  onlineLocationId         String?
  nextTransferNumber       Int           @default(1)
  dailySummaryOn           Boolean       @default(true)
  dailySummaryBy           String        @default("email")
  shipParcel               Json          @default("{}")
  nextTagNumber            Int           @default(101)
  nextOrderNumber          Int           @default(1001)
  // The next shop number for a stock item the maker gave no number (SB-00001 in StitchBench, SS-00001 in StitchShop)
  nextPartNumber           Int           @default(1)
  // Line at the bottom of register receipts (returns policy, hours)
  receiptNote              String?
  // The shop's own time zone: where days and months start for reports and statements
  timeZone                 String        @default("America/New_York")
  // Online booking (online-and-parts-design.md section 2): the public address /book/{bookingSlug}, on or off, the
  // first offered time this many hours from now, how far ahead, and the welcome text.
  bookingSlug              String?       @unique
  bookingOn                Boolean       @default(false)
  bookingLeadHours         Int           @default(24)
  bookingDaysAhead         Int           @default(60)
  bookingWelcome           String?
  // The online shop (online-and-parts-design.md section 3): /shop/{bookingSlug} (the same public address as booking),
  // on or off, pickup at the counter and / or flat-rate shipping, who takes the money ("own": the shop's Stripe account,
  // its keys sealed below; "platform": the hosted service's account, paid out to the shop by hand), the welcome and
  // the pickup instructions.
  shopOn                   Boolean       @default(false)
  shopPickup               Boolean       @default(true)
  shopShipping             Boolean       @default(false)
  shopShipCents            Int           @default(0)
  shopFreeOverCents        Int?
  shopPayVia               String        @default("own")
  // Sales tax on online orders: "rate" (the shop's one rate, as at the counter) or "stripe" (Stripe Tax works out the
  // tax on shipped orders from the delivery address; pickup orders stay at the rate). Own-account shops only.
  shopTaxVia               String        @default("rate")
  shopWelcome              String?
  shopPickupNote           String?
  stripeKeySealed          String?
  stripeWebhookSealed      String?
  nextWebOrderNumber       Int           @default(1001)
  // Layaway (tax-machine-sales-layaway-design.md section 4): the shop's defaults (owner's answer 3): the deposit as a
  // percent of the price, days to pay it off, payments every 2 weeks ("2w") or monthly ("month"), what cancelling keeps
  // (a fee in cents and / or a percent of what was paid), how the rest goes back ("credit": store credit, "money": the
  // way they paid), and the terms the customer signs (blank: the program's default wording).
  layawayDepositPct        Int           @default(10)
  layawayDays              Int           @default(90)
  layawayEvery             String        @default("2w")
  layawayFeeCents          Int           @default(0)
  layawayFeePct            Int           @default(0)
  layawayRefund            String        @default("credit")
  layawayTerms             String?
  nextLayawayNumber        Int           @default(1)
  // Special orders and pre-orders (shop-features-round-2-design.md 1.2): the deposit asked by default (a percent of the
  // price, or a set amount; both 0: none), what cancelling does with the deposit ("credit": store credit, "refund": the
  // money back, "keep": kept), and the days after it's here before it shows on the dashboard as not picked up.
  specialOrderDepositPct   Int           @default(0)
  specialOrderDepositCents Int           @default(0)
  specialOrderDepositRule  String        @default("credit")
  specialOrderDays         Int           @default(30)
  nextSpecialOrderNumber   Int           @default(1001)
  // "Price includes the tax" promotions allowed (tax-machine-sales-layaway-design.md section 2, owner's answer 5): off
  // until the owner turns it on past the warning that some states forbid advertising it.
  taxIncludedOn            Boolean       @default(false)
  // Software licences (shop-features-round-2-design.md 2.5): a licence sold here counts as activated on the sale date
  // (on), or only when the shop marks it activated (off, the default).
  softwareActivatedAtSale  Boolean       @default(false)
  // The kind /tickets/new opens on (sewing, vacuum, stand-mixer, 3d-printer, resin-printer, other, or a shop kind's key)
  checkInKind              String        @default("sewing")
  // Vac Shop "bags due": days between bag purchases
  bagReminderDays          Int           @default(180)
  // The lifetime discount a vacuum sold here gives on its supplies, by default (1.5)
  lifetimePctDefault       Int           @default(25)
  // The birthday offer (1.6): { kind: "pct" | "credit", value } (a percent off one sale, or store credit in cents),
  // during the birthday month, once a year; null: none
  birthdayOffer            Json?
  // Loaners (1.7): the deposit asked by default (0: none, a "card on file" note instead) and the days a loaner is lent
  // for by default (tickets carry no promised date)
  loanerDepositCents       Int           @default(0)
  loanerDays               Int           @default(14)
  // Trial purchases (1.8): machines sold with "Try it for N days" (0: off)
  trialDays                Int           @default(0)
  // Trade-up credit (1.9): a repair's cost taken off a new machine bought within this many days (0: off), and the
  // trade-in value rule: what the shop expects to sell it for, less this percent
  tradeUpDays              Int           @default(0)
  tradeInLessPct           Int           @default(30)
  // Set by the StitchBench administrator (Companies): this company can't write to the community hub
  hubWritesOff             Boolean       @default(false)
  // Customer answers (shop-features-round-2-design.md 5.6): the shop's opening hours for the public page's Hours answer
  // ([{ day: 0-6, from: "HH:MM", to: "HH:MM" }], the appointment types' shape), a line under them ("Closed on holidays"),
  // and the phone-answering service's key (sha256 of it; the key is shown once) with when it was made.
  openHours                Json          @default("[]")
  hoursNote                String?
  statusKeyHash            String?
  statusKeyAt              DateTime?
  // Techs may offer manuals to the hub's repository (Settings -> Community hub); off by default: strikes land on the owner's account.
  techsOfferManuals        Boolean       @default(false)
  manualOffers             ManualOffer[]
  // This company's StitchHub account and standing, as the hub last told it (hub-accounts-billing-design.md 2.4, 5.2):
  // shown on Settings → Account. Only the hub's signed key (a License row with source "hub") changes what the program allows.
  hubAccountEmail          String?
  hubAccountVerified       Boolean       @default(false)
  hubStanding              String? // trial | active | past_due | waived | comped | lapsed, as the hub said
  hubStandingAt            DateTime? // when the hub last answered
  hubStandingUntil         String? // the hub's lastDay (YYYY-MM-DD), when it gave one
  hubStandingNote          String? // the hub's message, shown as it came
  // The owner allows a password reset from their StitchHub account (Windows program, package hosted-provisioning); off by default
  hubResetOptIn            Boolean       @default(false)
  // Which version of the hub's terms the company's account accepted: sent when the account is started from here, then as
  // the hub reports it at each claim (it may have been accepted again on the hub)
  termsVersion             String?
  // Moving the company to another install (company-move-design.md sections 7 and 8). movingAt: the owner confirmed the
  // move and this copy is read-only (Cancel clears it); movedTo: where it is going, in the owner's words, then the hub's
  // name for the new install once it says moved; movedOutAt: the hub said moved (package move-hub). movedInAt /
  // movedFrom: this copy came in from a move file (package move-import).
  movingAt                 DateTime?
  movedOutAt               DateTime?
  movedTo                  String?
  movedInAt                DateTime?
  movedFrom                String?
  // Joining this company into another as a store (round-2 7.6): a one-time code its owner makes while signed in here
  // (hashed), good for 30 minutes, typed into the other company by the same person (never matched by email)
  joinCodeHash             String?
  joinCodeUntil            DateTime?
  joinCodeById             String?
  // Made by StitchHub's "Start a hosted shop" (POST /api/platform/companies, package hosted-provisioning): the Companies
  // page says "Started from StitchHub"
  startedFromHubAt         DateTime?
  // The Assistant add-on (ai-assistant-scope.md 2.3): this month's calls as the hub last counted them, in the company's
  // zone ("2026-10"), and the month's limit with any top-ups; the hub's count is the authority, this one shows offline.
  assistantMonth           String?
  assistantCalls           Int           @default(0)
  assistantLimit           Int           @default(300)
  // Product feeds for Google and Meta (shop-features-round-2-design.md 4.1, 4.2): the secret in the feed links (null: feeds
  // off) and the store code from the Google Business Profile, for the local inventory feed.
  feedToken                String?       @unique
  feedStoreCode            String?
  // Margin floor (shop-features-round-2-design.md 4.4): "tell me when an item's margin falls under N%", as {"all": 40} with
  // optional per-kind figures ({"FABRIC": 45}); null: off. src/lib/repricing-math.ts.
  marginFloor              Json?
  // Shop hops (shop-features-round-2-design.md 4.6): off until the shop turns it on (Settings, Selling); then the Shop hop
  // page shows in the menu.
  hopOn                    Boolean       @default(false)
  createdAt                DateTime      @default(now())

