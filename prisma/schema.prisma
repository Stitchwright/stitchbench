// One move of a company between installs (company-move-design.md section 8), as the job's state: an export (this
// install's copy going out as a .stitchmove.ndjson.gz file, streamed straight from the database while the owner's
// browser downloads it) or an import (package move-import). Status, for an export: ready (frozen, no download yet) |
// downloading | done | failed | cancelled. The row survives a page reload, so the Settings page shows where the
// download is. Per install (not in the file): it describes this copy's move, not the company.
model CompanyMove {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  direction      String // export | import
  status         String
  table          String? // the table being written now
  rowsDone       Int       @default(0)
  rowsTotal      Int       @default(0)
  bytes          BigInt    @default(0) // gzipped bytes sent so far (an export; a photo-heavy company's file passes 2 GB)
  filePath       String? // an import's file on disk (export streams; nothing is spooled)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  downloadedAt   DateTime?
  byUserId       String?
  // The hub's part (company-move-design.md section 5, package move-hub). An export: the hub the move token came from
  // and the token, sealed under "moveToken:<id>" (every download of this move carries the same one), or hubError when
  // the hub couldn't be asked. An import: the hub and the token the file named, the old install's places in the hub's
  // feeds (hubCursors, for the partner catch-up), then hubDoneAt once the hub has the company here, or hubError and the
  // "Re-point the hub" button. The token is dropped once used or cancelled.
  hubUrl         String?
  hubTokenSealed String?
  hubCursors     Json?
  hubDoneAt      DateTime?
  hubError       String?

  @@index([shopId, startedAt])
}

model User {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The person's home store (7.1): plain Location id; null = the main store
  locationId     String?
  // A manager's approval code at the register (7.5), hashed; null = none
  approveCode    String?
  // The code was set before codes were 6 numbers: Settings -> Stores asks her to change it
  approveCodeOld Boolean  @default(false)
  // Wrong approval codes typed by this person (counted before each try), and the 15 minutes' wait after five
  approveFails   Int      @default(0)
  approveLockedUntil DateTime?
  email          String
  name           String
  passwordHash   String
  role           Role     @default(TECH)
  active         Boolean  @default(true)
  // Bumped when the password changes or access is removed: sessions signed in before that stop working
  sessionVersion Int      @default(0)
  // Sales commission (shop-features-round-2-design.md 9.7): { pct, on: "machines" | "all" }; {} for none
  commission     Json     @default("{}")
  createdAt      DateTime @default(now())
  // The newest version whose "What's new" this person has seen (ease-of-use-design.md 2); null = never recorded
  whatsNewSeen   String?
  // Bigger text: "normal" | "large" | "larger"; null = normal
  textSize       String?

  notes          ModelNote[]
  ticketsOpened  Ticket[]        @relation("TicketOpenedBy")
  ticketsAsTech  Ticket[]        @relation("TicketTech")
  stockMoves     StockMove[]
  storeNoteReads StoreNoteRead[]
  sharedPosts    SharedPost[]
  sales          Sale[]
  shifts         Shift[]
  appointments   Appointment[]
  resets         PasswordReset[]

  // An email is unique inside one company (round 3 W1): the same address may have a login in several companies.
  @@unique([shopId, email])
  @@index([email])
}

// A one-use password link or reset (hub-accounts-billing-design.md 4.3, package hosted-provisioning). Only the sha256 of
// the token is kept. kind: "reset" (forgot your password, mailed, 1 hour), "setup" (a company started from StitchHub: the
// owner sets a first password, 24 hours), "admin" (the StitchBench administrator's reset link from Companies, 1 hour),
// "hub" / "hub-refused" (a StitchHub reset grant the Windows program's window allowed or refused: tokenHash is the
// grant's nonce hashed, so a grant works once whatever the hub sends again). usedAt: used, or cancelled by a newer one.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  kind      String    @default("reset")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// Customers: retail customers and trade accounts (quilt shops, dealers)
// ============================================================

enum CustomerKind {
  RETAIL
  TRADE
}

model Customer {
  kitSeries          KitSeriesMember[]
  clubMembers        ClubMember[]
  longarmOrders      LongarmOrder[]
  id                 String            @id @default(cuid())
  shopId             String
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind               CustomerKind      @default(RETAIL)
  name               String
  phone              String?
  email              String?
  address            String?
  // Trade accounts only
  code               String? // short code printed on route sheets, e.g. QS1
  commissionPct      Float?
  routeDay           String?
  notes              String?
  // How they want reminders and "it's ready" notices: email | sms | both | none; "" = not asked yet (email if we have one)
  notifyBy           String            @default("")
  // Marketing texts (TCPA): they agreed in writing - when, for which number, how, and the words they agreed to
  smsConsentAt       DateTime?
  smsConsentPhone    String?
  smsConsentSource   String?
  smsConsentText     String?
  // Review requests: when we last asked (at most one every Settings -> Messages "reviewEveryDays")
  lastReviewAskAt    DateTime?
  // Longarm rental: since when the shop has certified them to rent a machine (null: not certified)
  longarmCertifiedAt DateTime?
  createdAt          DateTime          @default(now())
  // Tax exempt (a resale or exemption certificate): sales and tickets for them charge no tax, with the number recorded
  taxExemptId        String?
  taxExemptUntil     DateTime?
  // Price group or membership (shop-features-round-2-design.md 1.5): the group whose discount the register gives her,
  // and the last day of a paid membership (YYYY-MM-DD; null: no end)
  priceGroupId       String?
  priceGroup         PriceGroup?       @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  priceGroupUntil    String?
  // Birthday (shop-features-round-2-design.md 1.6): month and day, only if she'd like to tell; the year she last used the
  // birthday offer (once a year)
  birthMonth         Int?
  birthDay           Int?
  birthdayUsedYear   Int?

  machines         Machine[]
  tickets          Ticket[]          @relation("TicketCustomer")
  viaTickets       Ticket[]          @relation("TicketViaAccount")
  sales            Sale[]
  giftCards        GiftCard[]
  layaways         Layaway[]
  repairJobs       RepairJob[]
  outMessages      OutMessage[]
  consentEvents    ConsentEvent[]
  enrollments      Enrollment[]
  appointments     Appointment[]
  softwareLicenses SoftwareLicense[]
  certifications   Certification[]
  makeJobs         MakeJob[]
  specialOrders    SpecialOrder[]
  wantItems        WantItem[]
  unitLoans        UnitLoan[]
  tradeUpOffers    TradeUpOffer[]

  @@index([shopId, name])
}

// ============================================================
// Machines (tracked by brand + model + serial)
// ============================================================

model Machine {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  brand            String
  model            String
  modelKey         String // normalized model for matching specs, notes and local manuals
  serial           String?
  machineType      String?
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes            String?
  // What it is (src/lib/equipment): SEWING (free) | VACUUM (Vac Shop module) | APPLIANCE (Small Appliance Repair module)
  equipment        String    @default("SEWING")
  // Its kind: sewing | vacuum | stand-mixer | 3d-printer | resin-printer | other | a shop kind's key (ShopEquipmentKind)
  kind             String    @default("sewing")
  // This unit's answers to its kind's intake fields that belong to the machine: { "<field key>": value }
  details          Json      @default("{}")
  // The completed service a "service due" reminder was last sent about (never twice for the same one)
  serviceNoticeFor DateTime?
  createdAt        DateTime  @default(now())

  tickets      Ticket[]
  photos       MachinePhoto[]
  repairJobs   RepairJob[]
  stock        StockUnit?
  vacCare      VacCare?
  suppliesCare SuppliesCare?
  plans        MachinePlan[]

  @@index([shopId, serial])
  @@index([shopId, brand, modelKey])
  @@index([customerId])
  @@index([shopId, equipment])
}

// Important facts and gotchas, attached to a brand + model (not to one machine),
// so every tech who opens that model sees them.
enum NoteKind {
  GOTCHA
  FACT
  TIP
}

enum PhotoKind {
  CONDITION // how it came in
  INSIDE // covers off: mechanism, boards
  WIRING // connectors and wire routing, for putting it back together
  PART // a worn or broken part
  AFTER // finished work
}

model ModelNote {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  brand      String
  modelKey   String
  modelLabel String
  kind       NoteKind @default(GOTCHA)
  body       String
  pinned     Boolean  @default(false)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([shopId, brand, modelKey])
}

// ============================================================
// Reference: factory thread-tension specs read out of OEM manuals.
// Shared by all shops. Seeded from prisma/seed-data/tension_specs.json.
// ============================================================

model TensionSpec {
  id               String   @id
  category         String // Embroidery | Sewing | Longarm | Industrial-Sewing
  brand            String
  models           String // as printed / as filed, e.g. "BAS-411, BAS-415"
  modelKeys        String[] // normalized model tokens for matching
  machineType      String?
  upperMinG        Float?
  upperMaxG        Float?
  bobbinMinG       Float?
  bobbinMaxG       Float?
  upperPrinted     String? // value and unit exactly as printed, e.g. "0.7-1.3 N"
  bobbinPrinted    String?
  upperText        String?
  upperConditions  String?
  bobbinText       String?
  bobbinConditions String?
  otherSpecs       String?
  sourceFile       String // PDF file name, used to find the manual in a tech's local library
  sourcePath       String? // where it sits in the reference library
  pages            String?
  docType          String?
  confidence       String?
  notes            String?

  @@index([brand])
}

// ============================================================
// Reference: factory timing and core adjustment standards read out of OEM service manuals.
// Shared by all shops. Seeded from prisma/seed-data/factory_settings.json.
// The manual's figure is drawn in each tech's browser from their own copy (figurePage + figureBox).
// ============================================================

model FactorySetting {
  id          String   @id
  category    String
  brand       String
  models      String
  modelKeys   String[]
  machineType String?
  adjustment  String // hook_timing_rise, needle_bar_height, feed_dog_height ... (see src/lib/adjustments.ts)
  label       String
  valueMin    Float?
  valueMax    Float?
  unit        String? // mm | deg | g | N | other
  valueText   String?
  conditions  String?
  reference   String?
  tools       String?
  sourceFile  String
  sourcePath  String?
  pages       String?
  figurePage  Int?
  figureBox   Float[] // [x0, y0, x1, y1] as fractions of the page; empty = whole page
  docType     String?
  confidence  String?
  notes       String?

  @@index([brand])
  @@index([adjustment])
}

// ============================================================
// Reference: how to put a machine into its test / service / diagnostic mode and leave it, and what the numbered tests
// do, in our own words with the manual page (handoff item 15). Shared by all shops. Seeded from
// prisma/seed-data/service_modes.json (scripts/library/service_modes_from_xlsx.py makes it from the owner's sheet).
// Matched to a machine by modelKeys alone: a row lists the twin models other brands sell. The picture of the entry keys
// is drawn from the tech's own manual like a factory setting's figure (figurePage + figureBox).
// ============================================================

model ServiceMode {
  id         String   @id
  brand      String
  models     String // as printed, e.g. "CS6000i, CS4000, ES2000, HS1000 series"
  modelKeys  String[] // normalized model tokens for matching, twins of other brands included
  category   String?
  mode       String // "Test mode", "Touch panel calibration", "Service program (menus 1-5)" ...
  enterSteps String[]
  exitSteps  String[]
  tests      Json // [{ code, purpose }], in the manual's order
  cautions   String?
  sourceFile String
  sourcePath String?
  pages      String? // 1-based PDF pages, e.g. "98, 102, 111"
  page       Int? // where the program opens the manual
  figurePage Int?
  figureBox  Float[]  @default([]) // [x0, y0, x1, y1] as fractions of the page; empty = whole page
  confidence String? // high | medium | low
  notes      String?

  @@index([brand])
}

// ============================================================
// Tickets / POS
// ============================================================

enum TicketStatus {
  AT_SHOP_AWAITING_PICKUP
  IN_TRUCK
  ON_BENCH
  WAITING_CUSTOMER_OK
  WAITING_PARTS
  READY_IN_TRUCK
  READY_FOR_PICKUP
  COLLECTED
  ABANDONED
  RETURNED_UNREPAIRED
}

model Ticket {
  id                  String       @id @default(cuid())
  shopId              String
  shop                Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId          String?
  number              Int
  status              TicketStatus @default(ON_BENCH)
  machineId           String
  machine             Machine      @relation(fields: [machineId], references: [id], onDelete: Restrict)
  customerId          String?
  customer            Customer?    @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  viaAccountId        String? // quilt shop / dealer the machine came through
  viaAccount          Customer?    @relation("TicketViaAccount", fields: [viaAccountId], references: [id], onDelete: SetNull)
  serviceRequested    String?
  problem             String?
  diagnosis           String?
  workDone            String?
  preApprovedCents    Int? // customer OK'd up to this much over the service price
  approvedCents       Int?
  estimateAnswer      String? // APPROVED | DECLINED: the customer's answer to the estimate (by link, phone or text reply); cleared when the ticket waits for an OK again
  estimateAnsweredAt  DateTime?
  accessories         String[] // what came in with the machine
  accessoriesReturned String[] // the subset confirmed back with the customer
  // Service checklist: { "<item text>": { done: true, by: "<user name>", at: "<iso>" } }
  checklist           Json         @default("{}")
  // Tension measured with gauges, grams-force
  upperFoundG         Float?
  upperLeftG          Float?
  bobbinFoundG        Float?
  bobbinLeftG         Float?
  // Timing / adjustment readings: { "<factory setting id>": { "found": 2.4, "left": 3.1 } }
  measurements        Json         @default("{}")
  taxRatePct          Float        @default(0)
  // The exemption certificate when this ticket was opened (or tax switched off for it); taxRatePct is then 0
  taxExemptId         String?
  intakeAt            DateTime     @default(now())
  readyAt             DateTime?
  // Since when it has been waiting on the pickup shelf: set on every move into READY_FOR_PICKUP, cleared on leaving it
  // (uncollected-machine notices count from here)
  pickupReadyAt       DateTime?
  // The pickup sheet (shop-features-round-2-design.md 5.5): "What we did" in plain words and the care tips chosen from
  // the shop's own list (their text, as printed), printed with the invoice
  pickupWhat          String?
  pickupTips          String[]     @default([])
  closedAt            DateTime?
  warrantyUntil       DateTime?
  // The trade account's commission % as it was when the ticket closed (null while open): editing the account later
  // doesn't rewrite past months
  tradeCommissionPct  Float?
  openedById          String?
  openedBy            User?        @relation("TicketOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  techId              String?
  tech                User?        @relation("TicketTech", fields: [techId], references: [id], onDelete: SetNull)
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  // BENCH: brought to the shop (every ticket before modules). SITE: work at the customer's (central vac install)
  jobType             String       @default("BENCH")
  // The kind's intake answers for this visit { "<field key>": value }, and its readings { "<key>": { "found": x, "left": y } }
  intake              Json         @default("{}")
  readings            Json         @default("{}")

  lines    TicketLine[]
  payments Payment[]
  waits    PartWait[]
  photos   MachinePhoto[]
  site     TicketSite?

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, status, closedAt]) // review requests: collected in the last two days
  @@index([shopId, machineId, intakeAt])
  @@index([machineId])
  @@index([customerId])
  @@index([viaAccountId])
  @@index([shopId, locationId])
}

enum LineKind {
  SERVICE
  LABOR
  PART
  FEE
  DISCOUNT
}

model TicketLine {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind           LineKind
  description    String
  qty            Float    @default(1)
  unitPriceCents Int
  taxable        Boolean  @default(true)
  partId         String?
  part           Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  // Covered by the machine's service plan (MachinePlan id, plain): the line charges 0 and coveredCents keeps what it
  // would have cost, for the report
  coveredPlanId  String?
  coveredCents   Int?
  // Claimed from the machine's maker under its warranty (WarrantyClaim id, plain; shop-features-round-2-design.md 9.1):
  // the line charges 0 and coveredCents keeps what it would have cost, as for a plan
  claimId        String?
  createdAt      DateTime @default(now())

  @@index([ticketId])
  @@index([coveredPlanId])
  @@index([claimId])
}

enum PaymentMethod {
  CARD
  CASH
  CHECK
  SHOP_COLLECTED
  INVOICE
  OTHER
  GIFT
  CREDIT
}

model Payment {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  amountCents Int
  paidAt      DateTime      @default(now())
  note        String?
  // A removed payment stays: a negative payment dated the day it was removed points at the original.
  reversesId  String?       @unique

  @@index([ticketId])
  @@index([paidAt])
}

// Menu of standard services with a set price (clean/oil/time/adjust etc.)
model ServiceItem {
  id            String  @id @default(cuid())
  shopId        String
  shop          Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  priceCents    Int
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
  // Price list grouping and the line under the name, e.g. "Domestic sewing" / "Clean, oil, adjust timing and tension"
  category      String?
  description   String?
  // The kind it's offered for (sewing, vacuum, stand-mixer, 3d-printer, resin-printer, other, or a shop kind's key); null = every kind
  equipmentKind String?

  @@index([shopId])
}

// ============================================================
// Parts inventory
// ============================================================

model Part {
  id                String        @id @default(cuid())
  shopId            String
  shop              Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partNumber        String
  description       String
  brand             String?
  fits              String? // models it fits, free text
  location          String? // bin / drawer
  qtyOnHand         Float         @default(0) // fabric sells in fractions of a yard
  reorderAt         Float         @default(0)
  costCents         Int?
  // The same cost in ten-thousandths of a dollar ($0.125 = 1250), for supplier prices finer than a cent; costCents is
  // this rounded to cents and is what margins and exports read. Empty on older parts: costCents is then exact.
  costTenThou       Int?
  priceCents        Int?
  // The maker's minimum advertised price (shop-features-round-2-design.md 9.3): below it, the online shop shows this price
  // and "Add to cart to see our price", and the cart shows the real one
  mapCents          Int?
  // Also listed on eBay, Etsy or Marketplace (9.7): [{ where, url }]; selling the last one here asks to take those down
  listedOn          Json          @default("[]")
  supplier          String?
  notes             String?
  createdAt         DateTime      @default(now())
  kind              PartKind      @default(PART)
  // Other numbers it's sold under (other makers' numbers, generic numbers)
  altNumbers        String[]
  // partNumber + altNumbers, upper-case letters and digits only, for matching the cross-reference
  numberKeys        String[]
  // null = sold each; "yd" = by the yard (fabric)
  unit              String?
  // Offered to partner sewing shops at this price (their catalog from this shop)
  wholesaleCents    Int?
  offerToPartners   Boolean       @default(false)
  // A partner repair shop's stock held here on consignment: which partnership, and the owner's id for the item
  consignLinkId     String?
  consignItemKey    String?
  // New, used or refurbished; and who made it: the machine maker (genuine), a compatible replacement or 3D printed
  condition         PartCondition @default(NEW)
  origin            PartOrigin    @default(GENUINE)
  // The maker gave no number, so partNumber is a shop number (SB-00001): never presented as the maker's
  ownNumber         Boolean       @default(false)
  // Listed in the online shop (section 3): needs a price; the customer's title and text, and up to four photos
  online            Boolean       @default(false)
  // Coming soon (shop-features-round-2-design.md 1.2): the day it is expected (YYYY-MM-DD); the register and the online
  // shop take pre-orders for it. A special order's deposit for this item is kept if she cancels (kit pre-registrations).
  comingSoonOn      String?
  depositKept       Boolean       @default(false)
  // An item that sells a membership (1.5): selling it puts the buyer in this price group for this many months
  membershipGroupId String?
  membershipMonths  Int?
  // Its own per-yard break (1.6): from this many yards, this price a yard ("this wide-back: $18 a yard from 3 yards")
  breakMinQty       Float?
  breakPriceCents   Int?
  onlineTitle       String?
  onlineText        String?
  // Fabric smarts (fabric-smarts-design.md section 6): the collection and designer, color tags, the yards on a full
  // bolt, whether the maker still prints it, and the items its cuts feed. The links are plain ids (no foreign key, so a
  // company file imports in any order); fabric.ts checks the target is this shop's own before using it.
  collection        String?
  designer          String?
  colorTags         String[]
  boltYards         Float         @default(15)
  inPrint           InPrint       @default(UNKNOWN)
  fatQuarterId      String?
  halfYardId        String?
  remnantId         String?
  // Item details (shop-features-round-2-design.md 2.1 and 6.2): the maker's own color number (Isacord 0015), its name, a
  // swatch color (#rrggbb), the material (thread's fibre, filament's PLA, resin's type, vinyl's kind, laser stock's
  // material), what it is (itemType: thread | filament | resin | blade | mat | vinyl | laser-material | die, null for
  // anything else) and the rest in specs (weight and put-up for thread, diameter and spool grams for filament, volume
  // for resin, size, thickness, shape). The three the counter search reads are columns; src/lib/item-details.ts.
  colorNumber       String?
  colorName         String?
  colorHex          String?
  material          String?
  itemType          String?
  specs             Json?
  // The shop's own color matches (shop-features-round-2-design.md 2.2): plain ids of this company's other items that
  // are the same color ("same as Madeira 1147"), kept both ways. No foreign key (a company file imports in any order);
  // src/lib/colors.ts reads only the company's own.
  sameAs            String[]      @default([])
  // Which machines it fits (shop-features-round-2-design.md 2.4): models as the shop picked them ("Brother PE800"), their
  // model keys (modelKey of the model, what every lookup matches on), and fit groups the shop named (plain ids of this
  // company's FitGroup rows: no foreign key). The free-text `fits` stays for notes. src/lib/fits.ts.
  fitsModels        String[]      @default([])
  fitsKeys          String[]      @default([])
  fitGroupIds       String[]      @default([])
  // Software (2.5, kind SOFTWARE): ONCE (perpetual) or SUBSCRIPTION (licenseMonths long), and the no-returns words the
  // receipt prints (blank: the default, "Software can't be returned once it has been activated.").
  licenseKind       String?
  licenseMonths     Int?
  noReturnText      String?

  softwareLicenses SoftwareLicense[]
  softwareCodes    SoftwareCode[]

  // The barcode number (UPC / EAN, a GTIN) for Google and Meta product feeds (shop-features-round-2-design.md 4.1): typed or
  // scanned on the item page; empty: the feed uses a valid GTIN among the item's numbers. Digits only, check digit checked.
  gtin String?

  moves         StockMove[]
  levels        StockLevel[]
  transferLines StockTransferLine[]
  markdowns     FabricMarkdown[]
  poLines       PurchaseOrderLine[]
  kitLines      KitLine[]
  kitStock      Kit[]               @relation("KitStock")
  photos        PartPhoto[]
  lines         TicketLine[]
  sources       PartSource[]
  saleLines     SaleLine[]
  waits         PartWait[]

  // The number is also unique in any case: a unique index on (shopId, lower(partNumber)), which Prisma can't express,
  // in migration 20260930220000_round3_tail2_part_number_ci. Writes catch its P2002 (partNumberClash in lib/parts.ts).
  @@unique([shopId, partNumber])
  @@index([numberKeys], type: Gin)
  @@index([shopId, itemType])
  @@index([fitsKeys], type: Gin)
}

// A software licence sold (shop-features-round-2-design.md 2.5): the item, the sale line, the customer and the machine it
// is for, the activation code (null until it is filled in: the "Codes to fill in" list), ONCE or SUBSCRIPTION with its
// renewal date, when it was activated, and where it stands (ACTIVE | RENEWED | RETURNED | ENDED). The code is the shop's
// record of the sale: masked in lists, never sent to the hub or the Assistant. renewNoticeFor: the renewal date the
// friendly reminder went out about (never twice for the same one).
model SoftwareLicense {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partId         String?
  part           Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)
  description    String
  saleId         String? // plain ids: the sale and line that sold it
  saleLineId     String?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  machineId      String? // plain id of one of the customer's machines
  code           String?
  kind           String    @default("ONCE") // ONCE | SUBSCRIPTION
  startsOn       DateTime
  renewsOn       DateTime?
  activatedAt    DateTime?
  status         String    @default("ACTIVE") // ACTIVE | RENEWED | RETURNED | ENDED
  note           String?
  renewNoticeFor DateTime?
  renewedFromId  String? // a renewal: the licence it carries on (plain id), RENEWED until this one is voided
  returnLineId   String? // the sale line that took it back (plain id): voiding that return makes it active again
  createdAt      DateTime  @default(now())

  @@index([shopId, status, renewsOn])
  @@index([shopId, customerId])
  @@index([shopId, saleId])
}

// An activation code on hand (2.5): cards in a drawer or a distributor's list, loaded on the software item; the
// register fills the next one in by itself. usedById: the licence it went to (plain id).
model SoftwareCode {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  code       String
  usedById   String?
  receivedAt DateTime @default(now())

  @@unique([shopId, partId, code])
  @@index([shopId, partId, usedById])
}

// A starter bundle (shop-features-round-2-design.md 6.1): what the shop puts with a new machine of a kind ("Bambu starter:
// 2 spools PLA, build plate glue"), added to the sale in one tap. kind: the equipment kind's key; lines: [{ partId, qty }]
// with plain ids of this company's items (checked when used).
model StarterBundle {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  lines     Json     @default("[]")
  createdAt DateTime @default(now())

  @@unique([shopId, name])
  @@index([shopId, kind])
}

// A fit group (shop-features-round-2-design.md 2.4): a name the shop gives once ("Brother 7 mm low shank", "Cricut
// Maker 3", "Bambu P1 hot end") and the models in it; an item that fits the group fits every one of them. `models` as
// typed ("Brother PE800"), `modelKeys` their keys.
model FitGroup {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  models    String[] @default([])
  modelKeys String[] @default([])
  createdAt DateTime @default(now())

  @@unique([shopId, name])
  @@index([modelKeys], type: Gin)
}

enum InPrint {
  YES
  NO
  UNKNOWN
}

enum PartKind {
  PART
  ACCESSORY
  SUPPLY
  NOTION
  FABRIC
  THREAD
  PATTERN
  SOFTWARE // embroidery, cutting-machine or slicer software sold with an activation code (shop-features-round-2-design.md 2.5)
  MACHINE // a machine model from a distributor's list, ordered on a purchase order; never stock itself: receiving it makes machines for sale (StockUnit)
}

enum PartCondition {
  NEW
  USED
  REFURB // cleaned and tested
}

enum PartOrigin {
  GENUINE // the machine maker's part
  COMPATIBLE // a replacement that isn't the maker's, e.g. an aftermarket screen
  PRINTED // 3D printed
}

// Where this shop buys a part (its own list; the community's list is on the cross-reference).
model PartSource {
  id         String   @id @default(cuid())
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  vendor     String
  url        String?
  priceCents Int?
  note       String?
  preferred  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([partId])
}

enum MoveReason {
  RECEIVED
  USED
  RETURNED
  ADJUSTED
  SOLD // over the counter (register) or to a partner shop
  CONSIGNED // sent to, or taken back from, a partner shop's consignment shelf
  CUT // fabric cut into fat quarters, half yards or a remnant: one move out of the bolt, one into the item it feeds
  HELD // set aside for a layaway (off the shelf), or back on the shelf when it is picked up or cancelled
  TRANSFER // sent to, or arrived from, another store of the company (7.2)
}

model StockMove {
  id          String     @id @default(cuid())
  shopId      String
  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store whose shelf it moved (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId  String?
  partId      String
  part        Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  qty         Float // + in, - out
  reason      MoveReason
  ticketId    String?
  note        String?
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  // A CUT move: the item on the other side of the cut (the bolt for the move in, the target for the move out)
  otherPartId String?
  createdAt   DateTime   @default(now())

  @@index([partId, createdAt])
  @@index([shopId, createdAt])
  @@index([shopId, locationId])
}

// ============================================================
// Machine photos (stored in Postgres; resized in the browser before upload)
// ============================================================

model MachinePhoto {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  machineId String
  machine   Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  ticketId  String?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  caption   String?
  kind      PhotoKind @default(CONDITION)
  mime      String
  data      Bytes
  createdAt DateTime  @default(now())

  @@index([machineId])
  @@index([shopId, kind])
}

// ============================================================
// In-house reference library (shared by the shop's techs)
// ============================================================

// Every manual in the shop library (C:\Manuals), so a model page can list them
// with their path. Techs keep the library at the same path on every PC.
model LibraryDoc {
  id           String    @id
  path         String    @unique // relative to the library root, backslashes, e.g. Sewing\Janome\ServiceManuals\X.pdf
  category     String
  brand        String
  file         String
  docType      String?
  title        String?
  pages        Int?
  sizeBytes    Int?
  modelKeys    String[]
  // When the file was downloaded from a hub link: which link and where from, so the link isn't downloaded twice.
  // (A sidecar <file>.pdf.json next to the file holds the same, and survives the library index being rebuilt.)
  linkId       String?
  sourceUrl    String?
  downloadedAt DateTime?
  // Hashes of the bytes (downloads and offers: sha256; the Python index: sha1), so a file held under another name is not fetched again.
  sha256       String?
  sha1         String?
  // The repository took this manual down (copyright notice, or withdrawn by the hub's owner): the model page says so and offers "Delete my copy".
  withdrawnAt  DateTime?
  withdrawnWhy String?

  @@index([brand])
  @@index([linkId])
  @@index([sha256])
  @@index([sha1])
}

// A hub link queued to be downloaded into this install's library ("Download everything" for a model, a brand, or every
// link not yet here). The server's timer takes one row at a time with a pause between, so a maker's site is never
// hammered; rows stay after a restart, so the job carries on where it stopped. The library is one per install, but the
// row remembers which company asked, and its progress shows to that company.
model ManualDownload {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  jobId      String // every row queued by one click shares it
  jobLabel   String // "Janome MC6700P", "Juki", "every link not in the library"
  linkId     String // the ManualLink's id (the hub's); no relation: links come and go with the hub sync
  status     String    @default("QUEUED") // QUEUED | DOWNLOADING | DONE | FAILED
  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  tries      Int       @default(0)
  path       String? // where it was saved, relative to the library root (backslashes)
  filed      Boolean   @default(false) // true: under Category\Brand with a LibraryDoc row; false: _inbox
  error      String? // why it failed, in the user's words
  retryAfter DateTime? // the hub said "later" (a 429 on a repository file): not taken before this

  @@index([shopId, jobId])
  @@index([status, queuedAt])
  @@index([linkId])
}

// A manual this company chose to offer to the hub's repository (manual-repository-design.md 3 and 6.2): one row per file,
// made only by the offer action. It is the company's list of offers and where they stand on the hub (refreshed at each
// sync). Stays on the install in a company move: it points at this PC's library and this install's uploads on the hub.
model ManualOffer {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId           String? // who offered it (no relation: people come and go)
  byName           String
  path             String? // in the library (backslashes); null when offered from the browser's own folder (hosted)
  fileName         String
  sha256           String
  sizeBytes        Int
  category         String
  brand            String
  models           String // as written: "PR650, PR655"
  docType          String
  year             Int?
  language         String   @default("English")
  title            String?
  statementVersion String
  statementAt      DateTime
  hubUploadId      String?
  hubManualId      String? // the repository's id for the manual once the hub says (duplicate, published)
  state            String   @default("SENDING") // SENDING | WAITING | PUBLISHED | NOT_ACCEPTED | DUPLICATE | BLOCKED | REMOVED | FAILED
  reason           String?
  tries            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shopId, createdAt])
  @@index([hubUploadId])
}

// A picture of the machine, cut from its own manual (cover or front pages).
model ModelImage {
  id         String   @id
  brand      String
  models     String
  modelKeys  String[]
  sourcePath String
  page       Int
  mime       String
  width      Int
  height     Int
  data       Bytes

  @@index([brand])
}

// A figure cut from a manual page for a timing/adjustment setting, stored so it
// shows on any device. Keyed by manual + page + crop box.
model FigureImage {
  id         String   @id // sha1(sourcePath|page|box)[:24]
  sourcePath String
  page       Int
  box        Float[]
  mime       String
  width      Int
  height     Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([sourcePath, page])
}

// A tech's write-up shared with every shop on StitchBench: an issue found, how it was fixed, with photos.
// Photos are copied in, so the shop's own machine photos (and its customers and serials) stay private.
model SharedPost {
  id        String        @id @default(cuid())
  shopId    String
  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  brand     String
  model     String
  modelKey  String
  kind      NoteKind      @default(GOTCHA)
  title     String
  body      String
  createdAt DateTime      @default(now())
  photos    SharedPhoto[]
  // Set once it has been sent to the community hub (its HubPost id there).
  hubId     String?       @unique

  @@index([modelKey])
  @@index([createdAt])
}

model SharedPhoto {
  id        String     @id @default(cuid())
  postId    String
  post      SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      PhotoKind
  caption   String?
  mime      String
  data      Bytes
  sortOrder Int        @default(0)

  @@index([postId])
}

// ---------- community hub (the install's side) ----------
// The community hub is a separate small server (the stitchbench-hub project). It holds what the StitchBench
// community shares: manual LINKS (never the PDFs), shared tech notes and photos, and manual figure snapshots.
// These tables are this install's synced copy of it.

// Where a manual can be downloaded from. Anyone can fix a link on the hub; history and rollback live there.
model ManualLink {
  id         String    @id // the hub's id
  category   String?
  brand      String
  models     String // as written, e.g. "PR650, PR655"
  modelKeys  String[]
  docType    String?
  title      String
  fileName   String? // the library file name it was filed as, when known
  url        String
  source     String? // site, e.g. janome.com
  status     String    @default("unchecked") // ok | dead | blocked (site refuses automatic checks) | unchecked
  httpStatus Int?
  checkedAt  DateTime?
  updatedAt  DateTime
  // "link" (a web link shared by a shop) or "repository" (a file in the hub's manual repository: id repo_<manual id>, url
  // stitchhub:repository/<id>, never opened as a web link). The rest is what the repository's feed says about the file.
  origin     String    @default("link")
  sizeBytes  Int?
  sha256     String?
  sha1       String?
  year       Int?
  language   String?
  pages      Int?

  @@index([modelKeys], type: Gin)
  @@index([brand])
}

// Tech notes shared by every shop in the community.
model HubPost {
  id         String     @id // the hub's id
  shopName   String
  authorName String?
  brand      String
  model      String
  modelKey   String
  kind       NoteKind   @default(GOTCHA)
  title      String
  body       String
  mine       Boolean    @default(false) // shared from this install
  // The company on the sharing install that shared it (from hubs that say; several companies can share one install)
  shopRef    String?
  createdAt  DateTime
  photos     HubPhoto[]

  @@index([modelKey])
}

model HubPhoto {
  id        String    @id // the hub's id
  postId    String
  post      HubPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      PhotoKind
  caption   String?
  mime      String
  data      Bytes? // fetched from the hub the first time someone looks at it
  sortOrder Int       @default(0)

  @@index([postId])
}

// Figure snapshots the hub has, so the app can show them without a local copy.
model HubFigure {
  id   String  @id
  mime String?
  data Bytes? // fetched from the hub the first time someone looks at it
}

// This install's connection to the hub (set in Settings → Community hub).
model HubState {
  id               Int       @id @default(1)
  url              String?
  hubName          String?
  discordUrl       String? // the community's Discord invite (menu: Community chat)
  installId        String?
  installKey       String?
  joinedAt         DateTime?
  cursor           String? // the hub's "changes since" marker
  orderCursor      String? // same for marketplace orders
  lastSyncAt       DateTime?
  lastError        String?
  // member = joined the community; partner = joined with a partner shop's code only (partner channel only)
  scope            String    @default("member")
  partnerCursor    String?
  partnerSyncAt    DateTime?
  partnerError     String?
  // One partner sync at a time across every server process on this install
  partnerLockUntil DateTime?
  // The connection this install left (Leave the hub): joining that hub again, while it still knows the install, keeps
  // the same install, so the shop's listings, orders and shared notes stay its own. Dropped on joining any hub.
  formerUrl        String?
  formerInstallId  String?
  formerInstallKey String?
  // The manual repository (manual-repository-design.md 5.1): its own feed cursor, and whether the hub takes offers
  // ("open", or "soon" while REPO_UPLOADS is off there; null: not asked yet) and when that was last asked.
  repoCursor       String?
  repoUploads      String?
  repoProbeAt      DateTime?
}

// The community parts cross-reference (synced copy): one physical part, every number it goes by, what it fits.
model XPart {
  id         String   @id // the hub's id
  name       String
  kind       String   @default("PART")
  category   String?
  specs      String?
  notes      String?
  numbers    Json // [{ brand, number }]
  numberKeys String[]
  fits       Json // [{ brand, model, modelKey, evidence, source }]
  fitKeys    String[]
  sources    Json // [{ id, vendor, url, priceCents, currency, note, byShop, updatedAt }]
  updatedAt  DateTime

  @@index([numberKeys], type: Gin)
  @@index([fitKeys], type: Gin)
}

// Cross-reference entries someone removed (from any shop), so they can be found and put back.
model RemovedXPart {
  id        String   @id // the hub's id
  name      String
  numbers   Json // [{ brand, number }] as they were
  removedAt DateTime

  @@index([removedAt])
}

// Marketplace listings from every shop on the hub (synced copy).
model Listing {
  id            String   @id // the hub's id
  shopName      String
  mine          Boolean  @default(false)
  title         String
  description   String?
  kind          String   @default("PART")
  condition     String   @default("NEW")
  // GENUINE | COMPATIBLE | PRINTED; null = the seller's install didn't say
  origin        String?
  brand         String?
  partNumber    String?
  numberKey     String?
  xpartId       String?
  fits          String?
  priceCents    Int
  currency      String   @default("USD")
  qty           Int
  shippingCents Int?
  shippingNote  String?
  shipsFrom     String?
  status        String
  photoIds      String[]
  createdAt     DateTime
  updatedAt     DateTime
  // The seller's install on the hub, and how buyers have rated them
  sellerId      String?
  sellerAvg     Float?
  sellerCount   Int      @default(0)
  // The company on the seller's install that listed it (from hubs that say), for its own ratings and shop page
  sellerRef     String?
  // The company on this install that listed it (mine listings only; several companies can share one install)
  shopId        String?

  @@index([status])
  @@index([numberKey])
}

// Listing photos, fetched from the hub the first time someone looks at them.
model ListingPhoto {
  id   String @id
  mime String
  data Bytes
}

// This shop's marketplace orders, as buyer or seller (synced copy of the hub's order).
model MarketOrder {
  id        String   @id // the hub's id
  number    String
  role      String // buyer | seller
  status    String
  data      Json // the whole order as the hub sent it
  updatedAt DateTime

  // The company on this install that placed it (buyer) or whose listing it is (seller)
  shopId String?

  @@index([role, status])
  @@index([shopId])
}

// ============================================================
// StitchShop: the sewing / quilt shop counter (register), and partnerships between a repair shop and the sewing
// shops that take machines in for it, buy parts and notions from it and hold its stock on consignment.
// Partner records exist on both sides with the same id and are kept in step through the hub (src/lib/partners.ts).
// ============================================================

// One register sale (or return: negative quantities).
model Sale {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId    String?
  number        Int
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subtotalCents Int
  discountCents Int       @default(0)
  taxCents      Int
  totalCents    Int
  taxRatePct    Float
  // The certificate number when the sale was tax exempt (taxRatePct is then 0)
  taxExemptId   String?
  // [{ method: CASH | CARD | CHECK | GIFT | OTHER, amountCents, note }]; cards are run on the shop's own terminal
  tenders       Json      @default("[]")
  changeCents   Int       @default(0)
  status        String    @default("COMPLETED") // COMPLETED | VOIDED
  voidedAt      DateTime?
  note          String?
  // The register's own name for the sale, the same on every try: a sale sent again isn't made twice
  clientKey     String?
  createdAt     DateTime  @default(now())

  lines SaleLine[]

  @@unique([shopId, number])
  @@unique([shopId, clientKey])
  @@index([shopId, createdAt])
  @@index([shopId, locationId])
}

model SaleLine {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  partId         String?
  part           Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)
  description    String
  partNumber     String?
  qty            Float
  unit           String?
  unitPriceCents Int
  discountCents  Int     @default(0) // off this line in total
  taxable        Boolean @default(true)
  costCents      Int? // unit cost when sold, for margins (rounded to cents; qty x this is not the line's cost for a sub-cent part)
  // The same unit cost in ten-thousandths of a dollar (Part.costTenThou's scale), written with it by sales from now on;
  // empty on older lines and non-stock lines, where costCents is exact. Line cost = round(qty x this / 100) cents.
  costTenThou    Int?
  // Sold for a partner repair shop (consignment): the partnership and the owner's id for the item
  consignLinkId  String?
  consignItemKey String?
  // A customer paying for a machine the partner repair shop fixed
  repairJobId    String?
  // Vac Shop (plain ids, like repairJobId): a unit sold from stock (qty 1) or taken back (qty -1); a trade-in taken as
  // credit (qty -1); the customer's vacuum a bag, belt or filter was bought for ("bags due")
  stockUnitId    String?
  tradeInUnitId  String?
  machineId      String?
  // A class seat or an appointment paid (qty 1) or refunded (qty -1) on this line (plain ids)
  enrollmentId   String?
  appointmentId  String?
  // A gift card sold, loaded or paid out on this line (plain id)
  giftCardId     String?
  // A service plan sold on this line (the MachinePlan it made, plain id)
  machinePlanId  String?
  // Why a line that could be taxed wasn't (or was taxed differently): null, "exempt" (the customer's certificate),
  // "holiday:<TaxHoliday id>" (a sales tax holiday), "included" (the price includes the tax): for the receipt, a return and the tax report
  taxNote        String?
  // The promotion that priced this line (percent or amount off, or the price including the tax), plain id
  promotionId    String?
  // The price group whose discount priced this line (1.5, plain id), and what the receipt says about the line's price
  // rule: "Guild 10%", "Lifetime 25%", "10+ yd price", "Birthday 15%"; a membership line: "member:<prev group>|<prev until>"
  priceGroupId   String?
  priceNote      String?
  // Layaway (plain id): a payment toward it (kind LAYAWAY, qty 1), its payments used up when it is picked up or given
  // back when it is cancelled (kind LAYAWAY, qty -1), its cancel fee (LAYAWAY_FEE), or an item it held, sold on pick-up
  layawayId      String?
  // A special order (plain id): money paid toward it (kind DEPOSIT +), its deposits used up at pick-up or given back
  // (DEPOSIT -), a kept deposit (DEPOSIT_KEPT), or the item itself sold at pick-up
  specialOrderId String?
  // A loaner's or rental's money (plain id, 1.7, 1.8): its deposit (DEPOSIT), a kept deposit (LOAN_FEE), rent (RENT)
  unitLoanId     String?
  // Who sold it (User id, plain; shop-features-round-2-design.md 9.7): picked at the register, the person signed in by default
  soldById       String?
  // Bought from a customer's gift list (RegistryItem id, plain; shop-features-round-2-design.md 9.9): ticks it off
  registryItemId String?
  // The category it is reported under when sold (a part's kind, CLASS, APPOINTMENT, UNIT, REPAIR, TRADE_IN, GIFT_CARD, MISC)
  kind           String?

  @@index([saleId])
  @@index([stockUnitId])
  @@index([tradeInUnitId])
  @@index([machineId])
  @@index([enrollmentId])
  @@index([appointmentId])
  @@index([layawayId])
  @@index([registryItemId])
}

// A partnership with another shop, from this shop's side (the id is the hub's link id).
model PartnerLink {
  id             String
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  side           String // this shop's side: repair | retail
  partnerName    String
  status         String    @default("ACTIVE") // ACTIVE | ENDED
  // The agreed terms (PartnerTerms in src/lib/partner-terms.ts) and who accepted which version
  terms          Json      @default("{}")
  termsVersion   Int       @default(1)
  accepted       Json      @default("{}") // { repair: { name, at, version }, retail: { ... } }
  proposedTerms  Json? // a change one side offered, waiting for the other
  proposedBy     String?
  // The terms in force before this shop took the partner's proposal as agreed ({ terms, termsVersion, accepted,
  // adoptedVersion }): put back if the partner says it had replaced that proposal before the acceptance arrived
  priorTerms     Json?
  // A proposal this shop accepted that the partner had withdrawn meanwhile ({ version, terms, reason, at }): shown
  // on the agreement page until the next proposal is accepted
  withdrawnTerms Json?
  // Repair side: the trade account machines from this shop come in under
  accountId      String?
  // Retail side: the repair shop's catalog (parts, notions, accessories at partner prices)
  catalog        Json?
  catalogAt      DateTime?
  // Repair side: what was last sent, so an unchanged catalog isn't sent again
  catalogHash    String?
  // What the partner's program says it can do (caps.update: ["pickup"]), and what we last told it (hash)
  features       String[]  @default([])
  featuresHash   String?
  endedAt        DateTime?
  // The note typed when the partnership was ended, and which side ended it (repair | retail; the hub sends both)
  endNote        String?
  endedBy        String?
  // Signing (docs/round3 W2): the partner company's public key, pinned when the partnership was made (partnerKeyHow:
  // "code" and "code-checked" (the long code's fingerprint matched) for the redeemer, "invite" for the inviter, "first-message"
  // for a partnership older than signing, trusted on first use). Null while the partner's program doesn't sign.
  partnerKey     String?
  partnerKeyHow  String?
  partnerKeyAt   DateTime?
  // The highest sequence number taken from the partner's signed messages, and the one last used to sign our own
  // (milliseconds since 1970, so it keeps rising even after a restored backup)
  sigSeqIn       BigInt    @default(0)
  sigSeqOut      BigInt    @default(0)
  // Unsigned messages taken from the partner while it had no key pinned (an older program), and the last time
  unsignedIn     Int       @default(0)
  lastUnsignedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@id([shopId, id])
  @@index([shopId])
}

// A company's signing key for partner messages and invites (src/lib/partner-keys.ts): one row per company. The private
// key is sealed (secrets.ts) and never sent; a move leaves it out, so the company makes a new key on the new install.
// The bookkeeping export's names and choices (later-round-1-design.md 3.4), one row per company: the bookkeeper's own
// account names by key (blank keeps the default), one sales account or one per category, discounts netted into sales or
// shown apart, a card clearing account, and the last day already exported.
model BooksSettings {
  shopId          String   @id
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  accounts        Json     @default("{}")
  byCategory      Boolean  @default(false)
  netDiscounts    Boolean  @default(false)
  cardClearing    String   @default("")
  exportedThrough String? // "YYYY-MM-DD", the shop's day
  updatedAt       DateTime @updatedAt
}

// Off-site backup (later-round-1-design.md section 1), one row per company. OFF until the owner has made the recovery key
// and typed part of it back. The program keeps only the public half of the key pair.
model OffsiteSettings {
  shopId       String    @id
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  on           Boolean   @default(false)
  target       String    @default("hub") // hub | folder | bucket
  folderPath   String    @default("")
  // The shop's own S3-compatible bucket (offsite-bucket): { endpoint, bucket, region, accessKeyId, secretSealed }
  bucket       Json?
  publicKey    String? // base64, 32 bytes
  keyId        String? // the key's fingerprint, 16 hex characters
  keyMadeAt    DateTime?
  keyCheckedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// A company's index of its off-site store: the data files and the photo objects (each sent once). Travels with the company
// in a move, so photos aren't sent again afterwards.
model OffsiteObject {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name       String
  kind       String // data | photo
  photoTable String?
  photoId    String?
  size       Int
  sha256     String
  uploadedAt DateTime  @default(now())
  // When the photo's row left the database (its object goes after the grace period), or when the object was pruned
  goneAt     DateTime?

  @@unique([shopId, name])
  @@index([shopId, kind, uploadedAt])
}

// This install's history of runs (per install: not in a move).
model OffsiteRun {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | ok | failed
  bytes      BigInt    @default(0)
  photos     Int       @default(0)
  error      String?

  @@index([shopId, startedAt])
}

model PartnerKey {
  shopId        String   @id
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  publicKey     String // Ed25519, base64 of the SPKI DER
  privateSealed String?
  // Partner codes this company made that nobody has redeemed yet: [{ side, codeHash, expiresAt }]. A link.created is taken
  // only against one of these (or, for 15 days after the key was made, from an invite made before there was a record).
  invites       Json     @default("[]")
  createdAt     DateTime @default(now())
}

// Messages waiting to go to a partner through the hub (sent on the next partner sync).
model PartnerOutbox {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  linkId    String
  type      String
  data      Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  tries     Int       @default(0)
  error     String?
  // Not before this time (backs off while the hub or the internet is down)
  nextTryAt DateTime?
  // The hub refused it for good (bad data, unknown link): kept and shown, never retried
  deadAt    DateTime?
  // The company's signature over it, made the first time it is sent and sent again with every retry
  sig       Json?

  @@index([sentAt, createdAt])
  @@index([shopId, linkId, sentAt])
}

// What the Help button sent (help, idea, rating) and the errors the program noticed, waiting for the hub
// (help-feedback-design.md section 3). Sent by the background sync; kept 30 days after sentAt; the picture goes once sent.
model HelpOutbox {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind        String // help | bug | idea | rating | error
  // Everything but the picture: the words, stars, reply address, page, program, version, and an error's message and stack
  payload     Json
  picture     Bytes? // JPEG of the screen, when the person left it in
  // Errors only: the same error on the same day is one row with a count (null for the other kinds)
  fingerprint String?
  day         String? // YYYY-MM-DD
  count       Int       @default(1)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  tries       Int       @default(0) // refusals by the hub (a 4xx other than 429); given up after 5
  lastError   String?

  @@unique([shopId, kind, fingerprint, day])
  @@index([sentAt, createdAt])
}

// Our answers to what a shop sent through the Help button, fetched from the hub at each sync (ease-of-use-design.md 4).
// hubId is the hub's id for the item; readAt is set when someone opens the Help panel.
model HelpReply {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  hubId     String
  kind      String // help | idea | rating | error
  text      String // the first words of what they sent
  reply     String
  repliedAt DateTime
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([shopId, hubId])
  @@index([shopId, repliedAt])
}

// A machine a sewing shop took in for its partner repair shop. Same id on both sides: the sewing shop's copy keeps
// its customer; the repair shop's copy points at the ticket it opened.
model RepairJob {
  id               String
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  linkId           String
  side             String // retail (we took it in) | repair (we fix it)
  tag              String // the sewing shop's claim-tag number
  status           String    @default("AT_SHOP_AWAITING_PICKUP") // TicketStatus names
  customerId       String? // retail side only; the customer's details never leave the sewing shop
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  machineId        String?
  machine          Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  customerName     String // what the repair shop sees: first name and last initial
  brand            String
  model            String
  serial           String?
  machineType      String?
  problem          String?
  serviceRequested String?
  accessories      String[]
  preApprovedCents Int? // customer OK'd up to this much without a call
  // From the repair shop: its ticket, the bill so far, and a note for the sewing shop
  ticketId         String?   @unique
  ticketNumber     Int?
  totalCents       Int?
  taxCents         Int?
  lines            Json? // [{ description, qty, amountCents }]
  commissionPct    Float     @default(0)
  commissionCents  Int? // the sewing shop's share of this repair
  repairNote       String?
  // The customer's answer to an estimate, relayed by the sewing shop
  approval         String? // APPROVED | DECLINED
  approvedCents    Int?
  // Payment: at the sewing shop's counter, or straight to the repair shop
  paidCents        Int?
  paidAt           DateTime?
  paidWhere        String? // shop | repair | split
  // Paid straight to the repair shop (deposits and full payments); paidCents is what the sewing shop collected
  repairPaidCents  Int?
  pickedUpAt       DateTime?
  events           Json      @default("[]") // [{ at, status, note }]
  sentHash         String? // repair side: what the sewing shop last heard
  snapshotAt       DateTime? // retail side: time of the repair shop's update last applied (older ones are ignored)
  // Retail side: when staff recorded it back at our counter (a run's hand-off or "It's back"); cleared if it leaves again
  backAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@id([shopId, id])
  @@index([shopId, status])
  @@index([shopId, linkId])
  @@index([shopId, machineId])
  @@index([shopId, side, backAt]) // uncollected-machine notices: back at the counter
  @@index([shopId, side, pickedUpAt]) // review requests: picked up in the last two days
}

// A sewing shop's order of parts, notions or accessories from its partner repair shop. Same id on both sides.
model PartnerOrder {
  id          String
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  linkId      String
  side        String // buyer | seller
  number      String
  status      String    @default("PLACED") // PLACED | ACCEPTED | DELIVERED | RECEIVED | CANCELLED
  lines       Json // [{ itemKey, partNumber, description, qty, unitCents }]
  totalCents  Int
  note        String?
  sellerNote  String?
  carrier     String?
  tracking    String?
  deliveredAt DateTime?
  receivedAt  DateTime?
  events      Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([shopId, id])
  @@index([shopId, linkId])
}

// Consignment: the repair shop's stock on a sewing shop's shelf. Owner side = my stock out there; holder side = the
// partner's stock I sell. itemKey is the owner's part id, the same on both sides.
model ConsignItem {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  linkId        String
  side          String // owner | holder
  itemKey       String
  partId        String?
  partNumber    String
  description   String
  priceCents    Int // the shelf price
  placed        Float     @default(0)
  sold          Float     @default(0)
  returned      Float     @default(0)
  countedQty    Float?
  countedAt     DateTime?
  // The sewing shop says it handed this much back; it goes on the shelf only when the repair shop confirms it arrived.
  pendingReturn Float     @default(0)
  pendingAt     DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([shopId, linkId, itemKey])
}

// Each consigned item sold at the sewing shop's counter (id = its sale line id, the same on both sides).
model ConsignSale {
  id             String
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  linkId         String
  itemKey        String
  qty            Float
  priceCents     Int // unit price it sold for
  saleNumber     Int?
  soldAt         DateTime
  // The sewing shop's share, fixed when the sale happened (later terms don't reprice it)
  shopKeepsCents Int?

  @@id([shopId, id])
  @@index([shopId, linkId, soldAt])
}

// A payment that settled a statement between partners (same id on both sides).
model Settlement {
  id          String
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  linkId      String
  periodFrom  DateTime
  periodTo    DateTime
  netCents    Int // + the sewing shop paid the repair shop; - the other way
  summary     Json
  note        String?
  byName      String?
  paidAt      DateTime  @default(now())
  // A payment the partner says it made counts once this shop confirms the money arrived (its own count at once)
  confirmedAt DateTime?

  @@id([shopId, id])
  @@index([shopId, linkId])
}

// Partner messages already applied (link + sending side + message id), so a message delivered twice counts once.
model PartnerSeen {
  shopId String
  key    String
  at     DateTime @default(now())

  @@id([shopId, key])
}

// Partner messages that couldn't be applied: bad data from the partner, or a failure that kept repeating. Set aside so
// one message can't stop every later one; shown on the Partners page.
model PartnerFailure {
  shopId  String
  key     String
  linkId  String
  type    String
  data    Json
  error   String
  tries   Int      @default(1)
  skipped Boolean  @default(false)
  at      DateTime @default(now())
  // The message's number on the hub, so "Try again" can fetch it whole (the data kept here leaves photos out)
  seq     String?

  @@id([shopId, key])
}

// ============================================================
// Paid modules (src/lib/modules.ts): Vac Shop, Small Appliance Repair, Scheduling, Marketing. A module is on while a
// license key the company pasted (its signature checked again on every look) or the administrator's switch on the
// hosted app says so. Switching off never deletes anything: records stay to look at and export; new work stops.
// ============================================================

// A license key pasted in Settings -> Modules. Only `key` counts: it is verified from its text every time it is read.
model License {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  keyId     String // the key's own id (payload "id"), as in the StitchBench owner's sales log
  key       String // the whole key as pasted: SB1.<payload>.<signature>
  addedBy   String? // name of the person who pasted it
  addedById String? // their User id
  // pasted: Settings → Modules (or the owner's emailed key); hub: fetched from StitchHub with the sync, one hub row per
  // company, replaced by the hub's next key and removed when the hub revokes it (hub-accounts-billing-design.md 3.5)
  source    String   @default("pasted")
  createdAt DateTime @default(now())

  @@unique([shopId, keyId])
  @@index([shopId, source])
}

// The StitchBench administrator's switch for one company's module (Companies screen, hosted app only). Rows are history;
// only rows newer than the newest "none" (keys decide) count: the newest "on" (a key signed with the hosting key) adds
// its dates, the newest "off" ends every key issued before it (src/lib/license.ts adminPosition). Ignored by the Windows
// program.
model ModuleGrant {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  module    String // base (the program itself) | vac | appliance | scheduling | marketing
  mode      String // on | off | none
  key       String? // mode on: SB1 key for this company and module, signed with the hosting key
  byEmail   String
  note      String?
  createdAt DateTime @default(now())

  @@index([shopId, module, createdAt])
}

// A kind of appliance the shop added itself ("What you repair"), e.g. espresso machines. Built-in kinds are never here.
model ShopEquipmentKind {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  equipment      String   @default("APPLIANCE") // APPLIANCE (the only one this version makes)
  key            String // lower-case letters, digits and dashes, e.g. espresso-machine (never a built-in key)
  label          String // "Espresso machine"
  noun           String? // "espresso machine" (in sentences)
  types          String[]
  brands         String[]
  accessories    String[]
  defaultChecked String[]
  checklist      String[]
  intakeFields   Json     @default("[]") // FieldDef[] (src/lib/equipment/types.ts)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shopId, key])
}

// The link in an online booking's confirmation (online-and-parts-design.md section 2): the customer opens
// /book/m/{token} to see, move or cancel their appointment or class seat. The token is hashed; it expires with the booking.
model BookingLink {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointmentId String? // plain ids, always checked with shopId
  enrollmentId  String?
  customerId    String?
  tokenHash     String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([shopId, appointmentId])
  @@index([shopId, enrollmentId])
}

// A part a ticket is waiting for (online-and-parts-design.md section 1): recorded when the shop has to order it,
// received when it is checked in (the parts_in notice goes out then), or cancelled when it isn't coming. Always
// written after checking the ticket is this shop's.
// A photo of an item for the online shop (section 3): stored like MachinePhoto, served by /api/shop/photo/{id} while the item is listed.
model PartPhoto {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([partId])
}

// An online order (section 3): made PENDING when the customer goes to pay, PAID by Stripe's word (the webhook or the
// return page), READY when staff have it packed for pickup, DONE when picked up or shipped, CANCELLED when refunded or
// never paid. `items` holds the lines as sold ([{ partId, partNumber, description, qty, unitPriceCents, short }]);
// the sale in the register's books (saleId) is made at payment, with tender ONLINE.
model WebOrder {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId      String?
  number          Int
  status          String    @default("PENDING")
  customerId      String?
  name            String
  phone           String?
  email           String?
  notify          String    @default("")
  fulfil          String    @default("pickup") // pickup | ship
  address         String?
  items           Json      @default("[]")
  subtotalCents   Int
  shipCents       Int       @default(0)
  taxCents        Int
  totalCents      Int
  refundedCents   Int       @default(0)
  payVia          String    @default("own") // own | platform
  taxVia          String    @default("rate") // rate | stripe (the tax known only when Stripe reports it)
  stripeSessionId String?   @unique
  stripeIntent    String?
  tokenHash       String    @unique
  linkSealed      String? // the order page's link (it carries the token), sealed, for the mail
  saleId          String?
  tracking        String?
  // A label bought through Shippo (shop-features-round-2-design.md 9.5): where to print it, the carrier and service,
  // what it cost the shop, and Shippo's transaction id
  labelUrl        String?
  labelCarrier    String?
  labelCents      Int?
  shippoTxId      String?
  note            String?
  staffNote       String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  readyAt         DateTime?
  doneAt          DateTime?
  cancelledAt     DateTime?
  // Pay links sent by staff (shop-features-round-2-design.md 1.3): "customer" (built in the online shop) or "staff" (the
  // lines filled in by the shop and the link texted or emailed); the special orders it pays toward (plain ids), who
  // made it, and the day the link stops working (a staff link waits for the customer; Stripe's page is opened on demand).
  source          String    @default("customer")
  specialOrderIds String[]  @default([])
  createdById     String?
  expiresAt       DateTime?

  @@unique([shopId, number])
  @@index([shopId, status, createdAt])
  @@index([customerId])
  @@index([shopId, locationId])
}

model PartWait {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  partId      String? // a stocked part, when it is one; null for a one-off ordered by description
  part        Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)
  description String // what the customer hears: "Bobbin case"
  qty         Float     @default(1)
  supplier    String?
  orderedAt   DateTime  @default(now())
  expectedOn  String? // YYYY-MM-DD
  receivedAt  DateTime?
  receivedBy  String?
  noticedAt   DateTime? // when the parts_in message was queued (never twice)
  cancelledAt DateTime?
  note        String?

  @@index([shopId, receivedAt, cancelledAt])
  @@index([ticketId])
  @@index([partId])
}

// Where and when a SITE ticket's work happens (central vac installs). The ticket keeps the bill, status and power unit.
model TicketSite {
  ticketId     String    @id
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  address      String
  startsAt     DateTime?
  endsAt       DateTime?
  contactName  String?
  contactPhone String?
  accessNotes  String? // gate code, pets, where to park
  updatedAt    DateTime  @updatedAt

  @@index([shopId, startsAt])
}

// A vacuum the shop sells (new or used; a trade-in). One row per physical unit for good; brand, model, serial and
// owner stay on its Machine. Never deleted: taking one off sale sets REMOVED.
model StockUnit {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId      String?
  machineId       String    @unique
  machine         Machine   @relation(fields: [machineId], references: [id], onDelete: Restrict)
  status          String    @default("IN_STOCK") // IN_STOCK | HELD (on a layaway) | SOLD | REMOVED
  layawayId       String? // the layaway holding it (plain id) while HELD
  condition       String    @default("NEW") // NEW | OPEN_BOX | REFURB | USED
  costCents       Int? // what it cost the shop (a trade-in: the credit given)
  priceCents      Int? // asking price
  mapCents        Int? // the maker's minimum advertised price (9.3): an asking price below it is never advertised
  // A customer's used machine on consignment (shop-features-round-2-design.md 9.6): whose it is (Customer id, plain), the
  // shop's commission (a percent of what it sells for) and the day to give it back or mark it down (YYYY-MM-DD)
  consignorId     String?
  consignPct      Float?
  consignUntil    String?
  // Also listed on eBay, Etsy or Marketplace (9.7): [{ where, url }]; selling it here asks to take those down first
  listedOn        Json      @default("[]")
  warrantyMonths  Int?
  warrantyBy      String? // who stands behind it: the maker's name, or the shop
  soldLineId      String? // SaleLine that sold it (kept after a return, until it sells again)
  soldAt          DateTime?
  soldNetCents    Int? // what the buyer paid for it before tax (its share of a whole-sale discount taken off): the most a return refunds
  returnLineId    String? // SaleLine that took it back from the buyer
  tradeInLineId   String? // SaleLine that took it in as a trade-in
  warrantyUntil   DateTime?
  registeredAt    DateTime? // warranty registered with the maker
  registrationRef String?
  note            String?
  // What comes with it, one item a line (accessories, software, a cabinet discount): printed on the receipt
  bundle          String?
  // Owner's classes ("guide classes") the buyer gets with it; used by signing up with Enrollment.creditUnitId
  classCredits    Int       @default(0)
  // A service plan included in the price (ServicePlan id, plain): put on the machine when it sells
  includedPlanId  String?
  // A lifetime discount on its supplies for the buyer (1.5, the vacuum's bags, belts and filters), percent
  lifetimePctOff  Int?
  // What the shop uses it for (shop-features-round-2-design.md 1.7): SALE (machines for sale, as before) | LOANER | DEMO |
  // RENTAL. Only SALE units show in the register's "sell a machine" search.
  use             String    @default("SALE")
  // A trial purchase (1.8): sold with "Try it for N days"; a return inside the window takes it back in full
  trialUntil      DateTime?
  events          Json      @default("[]") // [{ at, note, prev? }] (prev: the sale fields a trade-in cleared, put back if it is voided)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shopId, status])
  @@index([shopId, locationId])
}

// "Bags due" for a customer's vacuum: when someone last got in touch, snoozes and stops. Due dates come from sales.
// Always written after checking the machine is this shop's (the id alone is the key).
// "Supplies due" marks for a printer or cutter a customer bought here (shop-features-round-2-design.md 6.3, Maker Shop):
// the general twin of VacCare. calledAt: someone got in touch (by phone, or "message" for a one-off send); snoozeUntil:
// left off the list until then; stoppedAt: no more reminders for this machine.
// A customer certified to use one of the shop's machines on her own (shop-features-round-2-design.md 6.4): "Longarm",
// "Laser", "3D printer", after the safety class. Customer.longarmCertifiedAt is copied in as "Longarm" by the migration
// and kept in step until it is removed. byUserId: who certified her (plain id).
// A print or cut job (shop-features-round-2-design.md 6.5, package make-jobs, Maker Shop): the longarm work order's
// pattern for the shop's 3D printer, resin printer, laser or cutter. kind: PRINT | RESIN | LASER | CUT; status: QUOTED |
// APPROVED | WORKING | READY | COLLECTED | CANCELLED | TURNED_DOWN. The price: machine time x the rate + material used x
// its price + the set-up fee (all kept as worked out). The customer's file is kept until 30 days after pickup
// (fileDeleteAfter), then deleted. estimateLinkId and saleId are plain ids.
model MakeJob {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId      String?
  number          Int
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name            String
  kind            String    @default("PRINT")
  status          String    @default("QUOTED")
  title           String
  fileName        String?
  fileMime        String?
  fileData        Bytes?
  fileDeleteAfter DateTime?
  machineMinutes  Int       @default(0)
  materialPartId  String?
  materialName    String?
  materialQty     Float     @default(0)
  materialUnit    String? // g | ml | sheet
  materialCents   Int       @default(0)
  setupCents      Int       @default(0)
  rateCents       Int       @default(0)
  quoteCents      Int       @default(0)
  taxable         Boolean   @default(true)
  estimateLinkId  String?
  dueAt           DateTime?
  turnedDownWhy   String?
  saleId          String?
  note            String?
  approvedAt      DateTime?
  startedAt       DateTime?
  readyAt         DateTime?
  collectedAt     DateTime?
  closedAt        DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, locationId])
}

model Certification {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipment   String
  certifiedAt DateTime @default(now())
  byUserId    String?

  @@unique([shopId, customerId, equipment])
  @@index([shopId, equipment])
}

model SuppliesCare {
  machineId   String    @id
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  calledAt    DateTime?
  calledBy    String?
  callNote    String?
  snoozeUntil DateTime?
  stoppedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([shopId])
}

model VacCare {
  machineId    String    @id
  machine      Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  contactedAt  DateTime?
  contactedBy  String? // email | text | the name of whoever called
  contactNote  String?
  snoozedUntil DateTime?
  stopped      Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  @@index([shopId])
}

// ============================================================
// Scheduling and messages (design.md). Times are instants; each shop shows them in its own Shop.timeZone.
// ============================================================

// A pickup / drop-off run between partner shops: machines going to the repair shop and fixed ones coming back. Same id
// on both sides. The side that scheduled it (ownerSide) changes the plan; the other side can OK it or cancel it. Each
// side records only what it received: the repair side `collected` (the driver took these), the retail side
// `delivered` (these reached our counter). src/lib/partner-runs.ts
model PartnerRun {
  id          String
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  linkId      String
  status      String    @default("SCHEDULED") // SCHEDULED | CANCELLED | DONE
  ownerSide   String // repair | retail: the side that scheduled it and changes the plan
  rev         Int       @default(1) // plan revision; only ownerSide raises it
  startsAt    DateTime
  endsAt      DateTime?
  driver      String    @default("repair") // which shop drives: repair | retail
  collect     String[] // planned: RepairJob ids going to the repair shop
  deliver     String[] // planned: RepairJob ids coming back
  collected   String[] // recorded by the repair side: what the driver took
  collectedAt DateTime?
  delivered   String[] // recorded by the retail side: what reached its counter
  deliveredAt DateTime?
  note        String?
  okRev       Int? // the plan revision the other side OK'd
  okAt        DateTime?
  cancelledAt DateTime?
  events      Json      @default("[]") // [{ at, side, what, name?, note? }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([shopId, id])
  @@index([shopId, linkId, startsAt])
  @@index([shopId, startsAt])
}

// A company's message settings (Settings -> Messages). The mail password and the Twilio token / API key secret are
// sealed with the server's key (src/lib/messaging/secrets.ts) and never sent to the browser.
model MessagingSettings {
  shopId             String    @id
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Email: the shop's own mailbox (Gmail / Outlook app password) or a relay (SES, SendGrid, Mailgun, Brevo)
  emailOn            Boolean   @default(false)
  smtpPreset         String? // gmail | outlook | m365 | yahoo | sendgrid | mailgun | brevo | ses | other
  smtpHost           String?
  smtpPort           Int       @default(587)
  smtpSecurity       String    @default("starttls") // starttls | tls | none (a mail server on the shop's own network; Windows program only)
  smtpUser           String?
  smtpPassSealed     String?
  smtpPassSavedAt    DateTime?
  fromName           String?
  fromEmail          String?
  replyTo            String?
  replyWatchedAt     DateTime? // an admin said someone reads replyTo at least weekly (needed for marketing email)
  replyWatchedBy     String?
  emailDailyCap      Int       @default(300) // marketing emails a shop-day at most (a Gmail account allows about 500)
  // Texts: Twilio. The Account SID, and either the Auth Token or an API key (SK...) and its secret
  smsOn              Boolean   @default(false)
  twilioSid          String? // AC...
  twilioKeySid       String? // SK... when an API key is used (recommended); its secret is in twilioTokenSealed
  twilioTokenSealed  String?
  twilioTokenSavedAt DateTime?
  twilioFrom         String? // the shop's Twilio number, +15551234567
  smsDailyCap        Int       @default(300) // marketing texts a shop-day at most
  smsPartMills       Int       @default(11) // what Twilio charges per text part, in tenths of a cent (cost hints only)
  // Test texts go only to numbers an admin proved they hold (a code was texted to the number)
  testPhones         String[]  @default([])
  testPhonePending   String?
  testCodeHash       String?
  testCodeUntil      DateTime?
  // Text replies (STOP, START, HELP) are read up to here; a read that didn't finish starts again from here
  inboundAt          DateTime?
  inboundIncomplete  Int       @default(0)
  // How sending is going. A channel pauses on a wrong password or token, a daily quota, or a server refusing mail
  emailOkAt          DateTime?
  emailError         String?
  emailPausedAt      DateTime?
  emailPausedUntil   DateTime? // set: resumes by itself then (a quota); null: when saved again or the hourly check passes
  emailCheckAt       DateTime? // next automatic check of a paused channel
  smsOkAt            DateTime?
  smsError           String?
  smsPausedAt        DateTime?
  smsPausedUntil     DateTime?
  smsCheckAt         DateTime?
  // Marketing held until an admin has looked: every marketing message after a restore; marketing texts when replies
  // (STOP) couldn't all be read
  marketingHoldAt    DateTime?
  textHoldAt         DateTime?
  textHoldWhy        String?
  // The law's parts
  postalAddress      String?
  tzConfirmedAt      DateTime? // an admin confirmed Shop.timeZone (needed before any text goes out)
  tzConfirmedBy      String?
  smsRegisteredAt    DateTime? // an admin ticked "We've registered" (10DLC or toll-free): the registration guide shrinks to one line
  quietStart         Int       @default(540) // 9:00, minutes after midnight, shop time
  quietEnd           Int       @default(1200) // 20:00
  noSundayMarketing  Boolean   @default(true)
  smsConsentText     String? // the words customers agree to for marketing texts (a default when empty)
  consentTexts       Json      @default("[]") // earlier wordings [{ code, text, from, to }] for signed paper forms
  // Automatic messages
  readyNotice        Boolean   @default(true)
  reminders          Boolean   @default(true)
  reminderHour       Int       @default(10) // reminders go out from this hour the day before, shop time
  abandonNotices     Boolean   @default(false)
  abandonDays        Int[]     @default([7, 30]) // days after ready; the final notice goes finalNoticeDays before the abandon date
  finalNoticeDays    Int       @default(7)
  serviceDue         Boolean   @default(false)
  serviceDueMonths   Int       @default(12)
  serviceDueSince    DateTime? // when it was switched on: machines due before then go through a campaign instead
  serviceDueDay      String? // the shop day ("2026-10-07") it last ran
  reviewRequest      Boolean   @default(false)
  reviewUrl          String?
  reviewDelayHours   Int       @default(24)
  reviewEveryDays    Int       @default(180)
  reviewAfterSales   Boolean   @default(false)
  estimateLinkDays   Int       @default(7)
  // Online-order mail counts toward the marketing daily cap (off: it goes like a notice, uncapped)
  ordersInCap        Boolean   @default(false)
  // Wording of the automatic messages, { "<key>.sms" | "<key>.email" | "<key>.subject": text }; missing = default
  templates          Json      @default("{}")
  updatedAt          DateTime  @updatedAt
}

// Every email and text: waiting, sent, or not sent and why. Also the proof a notice went out (date, channel, words).
model OutMessage {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel        String // email | sms (sent from here); letter | certified_mail | phone (a notice given by hand, recorded as proof: status SENT)
  purpose        String // notice | marketing
  kind           String // MESSAGE_KIND_LABEL in src/lib/constants.ts
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address        String // the email address or +1 number, fixed when queued ("by hand" for a letter without one)
  subject        String?
  body           String // what goes out; an estimate link is kept masked here and put in by the worker at send time
  status         String    @default("QUEUED") // QUEUED | SENDING | SENT | FAILED | SKIPPED | CANCELLED | EXPIRED
  dedupeKey      String? // the same key is queued once per shop
  sendAfter      DateTime  @default(now())
  notAfter       DateTime? // never sent after this (a reminder two hours before the class)
  tries          Int       @default(0) // times claimed for sending
  retryTries     Int       @default(0) // failures that count toward giving up ("offline" doesn't)
  nextTryAt      DateTime?
  claimedAt      DateTime?
  sentAt         DateTime? // when it went (given by hand: the date it was given)
  providerId     String? // Twilio SID, the email's Message-ID, or a certified-mail tracking number
  deliveryStatus String? // texts: Twilio's final word (delivered | undelivered | failed)
  deliveryError  String?
  error          String?
  optOutToken    String?   @unique // random token in a marketing email's unsubscribe link (it can only unsubscribe that address)
  // What it's about (plain ids)
  ticketId       String?
  repairJobId    String?
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  refType        String? // meeting | appointment | enrollment | estimate | machine | stage | class
  refId          String?
  byUserId       String? // who sent or recorded it by hand; null = automatic
  cancelledById  String?
  createdAt      DateTime  @default(now())

  @@unique([shopId, dedupeKey])
  @@index([status, sendAfter])
  @@index([shopId, status, sendAfter])
  @@index([shopId, createdAt])
  @@index([shopId, customerId])
  @@index([shopId, ticketId])
  @@index([shopId, repairJobId])
  @@index([shopId, address, sentAt])
  @@index([campaignId, status])
}

// Addresses that get no messages: a text STOP (nothing at all, not even reminders) or an email unsubscribe (no
// marketing). Kept by address so it holds for a customer entered twice or with a changed record. Never purged.
model Suppression {
  shopId  String
  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel String // email | sms
  address String // lower-case email, or +1 number
  scope   String // marketing | all
  source  String // CONSENT_SOURCE_LABEL
  at      DateTime @default(now())

  @@id([shopId, channel, address])
}

// The consent record the law asks a shop to keep: every opt-in, opt-out and preference change, never edited or purged.
model ConsentEvent {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel    String // email | sms; any for notify_pref
  event      String // CONSENT_EVENT_LABEL: marketing_yes | marketing_no | notify_pref | optout | optin | help
  address    String? // the email or number it applies to
  source     String // CONSENT_SOURCE_LABEL
  detail     String? // the words agreed to, the reply as sent, the new preference
  byUserId   String?
  at         DateTime  @default(now())

  @@index([shopId, customerId, at])
  @@index([shopId, at])
}

// Texts customers sent to the shop's Twilio number, read every few minutes. STOP / START / HELP are acted on; the
// rest wait for someone to read them (and hold marketing texts to that number until they have).
model InboundText {
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sid        String // Twilio's message SID
  fromNumber String
  body       String
  receivedAt DateTime
  customerId String? // plain id: a customer with this number, when there is one
  keyword    String? // STOP | START | HELP | STOPLIKE (a stop in other words)
  handledAt  DateTime?
  handledBy  String?

  @@id([shopId, sid])
  @@index([shopId, receivedAt])
  @@index([shopId, fromNumber, receivedAt])
}

// A marketing message to a group of customers (sent now; the worker turns members into messages in batches).
model Campaign {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  channel     String // email | sms
  subject     String?
  body        String
  audience    Json // Audience in src/lib/messaging/audiences.ts
  status      String       @default("DRAFT") // DRAFT | QUEUING | SENDING | SENT | CANCELLED
  members     Json         @default("[]") // customer ids picked when it was sent
  built       Int          @default(0) // how many members have been turned into messages
  queuedAt    DateTime?
  finishedAt  DateTime?
  recipients  Int          @default(0) // messages queued
  skipped     Json         @default("{}") // { reason: count }
  createdById String?
  queuedById  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  messages    OutMessage[]

  @@index([shopId, createdAt])
  @@index([status])
}

// A link a customer opens to see an estimate and approve or decline it. Only the token's hash is kept for lookups; the
// token itself stays sealed only until the messages carrying it have gone out.
model EstimateLink {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  tokenSealed String?
  maskedUrl   String // how the link appears in stored message bodies, e.g. https://.../e/•••Xk3q
  ticketId    String? // a StitchBench ticket (plain id, always checked with shopId)
  repairJobId String? // or a partner repair job, the sewing shop's side
  makeJobId   String? // or a print or cut job (shop-features-round-2-design.md 6.5; plain id)
  customerId  String?
  totalCents  Int // the estimate as shown; a changed bill needs a new link
  lines       Json // [{ description, amountCents }] as shown
  note        String? // what the shop wrote with it
  expiresAt   DateTime
  answer      String? // APPROVED | DECLINED
  answerNote  String?
  answeredAt  DateTime?
  answerFrom  String? // the client address when a trusted proxy reports it, and the browser
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([shopId, ticketId])
  @@index([shopId, repairJobId])
  @@index([shopId, answeredAt])
}

// One copy of a background job at a time across every server process on this install (src/lib/lease.ts).
model JobLease {
  name   String   @id
  holder String // hostname:pid
  until  DateTime
}

// A class, workshop or club: one or more meetings, a seat limit, a fee rung up at the register.
model ShopClass {
  id                String         @id @default(cuid())
  shopId            String
  shop              Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId        String?
  title             String
  description       String?
  teacher           String?
  location          String?
  supplies          String? // supply list: on the roster, the sign-up message and the reminder
  feeCents          Int            @default(0)
  taxable           Boolean        @default(false)
  seats             Int
  waitlist          Boolean        @default(true)
  remind            String         @default("every") // day-before reminders: every | first (meeting only) | never
  status            String         @default("OPEN") // OPEN | CLOSED (no more sign-ups) | CANCELLED
  online            Boolean        @default(false) // customers may sign up themselves on /book/{slug}
  firstAt           DateTime? // first and last meeting, kept in step by the actions (for lists)
  lastAt            DateTime?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  // Events (shop-features-round-2-design.md 4.5): CLASS | EVENT (a trunk show, sew-in) | RETREAT; the early-bird price
  // until a day (YYYY-MM-DD, the shop's zone), a deposit each (refundable or not) with the balance due this many days
  // before the first day, the choices with their prices ([{ key, label, options: [{ label, cents }] }], plus a
  // "dietary" ask), and the price at the door. src/lib/events-math.ts.
  kind              String         @default("CLASS")
  earlyCents        Int?
  earlyUntil        String?
  depositCents      Int?
  depositRefundable Boolean        @default(false)
  balanceDays       Int            @default(60)
  choices           Json?
  doorCents         Int?
  meetings          ClassMeeting[]
  enrollments       Enrollment[]
  draws             EventDraw[]

  @@index([shopId, firstAt])
  @@index([shopId, locationId])
}

model ClassMeeting {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  classId   String
  shopClass ShopClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  cancelled Boolean   @default(false)
  note      String?

  @@index([shopId, startsAt])
  @@index([classId, startsAt])
}

// Someone signed up for a class (or waiting for a seat). One row per sign-up: signing up again after a cancel makes a
// new row. Paid and refunded at the register.
model Enrollment {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  classId       String
  shopClass     ShopClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name          String // the customer's name when they signed up (the roster keeps it)
  attendee      String? // who's coming when it isn't the customer (a child, a friend)
  status        String         @default("ENROLLED") // ENROLLED | WAITLIST | CANCELLED
  feeCents      Int // the price for this person
  taxable       Boolean        @default(false)
  paidCents     Int?
  paidAt        DateTime?
  paidLineId    String? // the register sale line that paid it
  refundedCents Int?
  refundedAt    DateTime?
  refundLineId  String?
  note          String?
  source        String         @default("counter") // counter | online
  // An owner's class that came with a machine bought here (the StockUnit id, plain): the seat is free
  creditUnitId  String?
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // Events (4.5): what she chose ({ room: "Single", meals: "All meals", dietary: "gluten free" }) and when she came in
  // the door; payments toward an event (deposit, balance) are EventPayment rows beside the one-payment paidAt above.
  choices       Json?
  checkedInAt   DateTime?
  eventPayments EventPayment[]

  @@index([classId, customerId])
  @@index([shopId, customerId])
  @@index([classId, status, createdAt])
}

// Something customers book a time for: a lesson, longarm rental, a machine drop-off or pickup.
model AppointmentType {
  id           String        @id @default(cuid())
  shopId       String
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId   String?
  name         String
  minutes      Int           @default(60)
  feeCents     Int           @default(0)
  taxable      Boolean       @default(false)
  hourlyCents  Int? // a rental by the hour: the fee is this x the hours booked (the fee above is then ignored)
  needsCert    Boolean       @default(false) // only customers certified to rent (the longarm) can book it
  // What they must be certified on (shop-features-round-2-design.md 6.4: "Laser", "3D printer"); empty with needsCert
  // means the longarm, as before.
  certFor      String?
  capacity     Int           @default(1) // bookings at the same time (two longarms: 2); shared by types with the same resource
  resource     String? // what it uses up, e.g. "Longarm": types naming the same resource share its capacity
  // When it can be booked: [{ day: 0-6 (Sunday 0), from: "10:00", to: "17:00" }]; empty = any time
  hours        Json          @default("[]")
  location     String?
  active       Boolean       @default(true)
  online       Boolean       @default(false) // customers may book it themselves on /book/{slug}
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@index([shopId, sortOrder])
  @@index([shopId, locationId])
}

model Appointment {
  id            String           @id @default(cuid())
  shopId        String
  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  typeId        String?
  type          AppointmentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  resource      String? // the type's resource when booked (capacity is counted per resource)
  blocked       Boolean          @default(false) // "Block this time": no customer, holds the resource
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name          String // who it's for, as booked ("" when blocked)
  title         String // the type's name when booked, or the reason for a block
  startsAt      DateTime
  endsAt        DateTime
  status        String           @default("BOOKED") // BOOKED | DONE | NO_SHOW | CANCELLED
  staffId       String?
  staff         User?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  ticketId      String? // a machine drop-off or pickup: the StitchBench ticket (plain id)
  repairJobId   String? // or the partner repair job, the sewing shop's side (plain id)
  feeCents      Int              @default(0)
  taxable       Boolean          @default(false)
  paidCents     Int?
  paidAt        DateTime?
  paidLineId    String?
  refundedCents Int?
  refundedAt    DateTime?
  refundLineId  String?
  note          String?
  source        String           @default("counter") // counter | online
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([shopId, startsAt])
  @@index([shopId, customerId])
  @@index([typeId, startsAt])
  @@index([shopId, resource, startsAt])
}

// Who works the counter when. The person may have no login: name is always set (a snapshot for users).
model Shift {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId  String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  startsAt    DateTime
  endsAt      DateTime
  role        String? // Counter, Classroom, Longarm... (free text)
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId, startsAt])
  @@index([userId, startsAt])
  @@index([shopId, locationId])
}

// Fabric markdown ladder (fabric-smarts-design.md section 2): one row each time a fabric's price is marked down a step, so
// the ladder knows the current step. regularCents is the price before step 1 (the steps are percents off it); the ladder
// is on this row while the fabric's price is still newCents. An undo (same shop day) restores oldCents and sets undoneAt.
model FabricMarkdown {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partId       String
  part         Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  step         Int // 1 to 3
  pct          Int // percent off the regular price at this step
  regularCents Int
  oldCents     Int
  newCents     Int
  reason       String
  userId       String? // a plain id, with the name kept: the row outlives a deleted login
  userName     String?
  createdAt    DateTime  @default(now())
  undoneAt     DateTime?

  @@index([shopId, partId, createdAt])
}

// Fabric ordering (fabric-smarts-design.md sections 5 and 6, package F3). A supplier the shop buys fabric from: the name is
// what the fabrics' supplier text says (found or made when an order is started). leadDays is the shop's own figure;
// learnedDays is worked out from received orders (sent to first received) and is what the reorder math uses once
// learnedOrders is more than 0. minOrderCents is a warning on the order, not a block.
model FabricSupplier {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  leadDays      Int?
  learnedDays   Int?
  learnedOrders Int       @default(0)
  minOrderCents Int       @default(0)
  orderEmail    String?
  createdAt     DateTime  @default(now())
  // Connectors (fabric-smarts-design.md section 5a, package F6): how an order goes to this supplier (email | file |
  // notions-marketing), the column mapping the catalog spreadsheet is read with, the column layout the cart-upload CSV
  // is written in, and the shop's own account number there. Never a login or password for the wholesaler's site.
  connector     String    @default("email")
  catalogMap    Json?
  orderLayout   Json?
  accountNumber String?
  catalogAt     DateTime?
  catalogNote   String?
  // What this supplier's list holds when a row doesn't say (shop-features-round-2-design.md 2.3): an item form's "What is
  // it?" value (FABRIC, THREAD, NOTION, SUPPLY:filament...). Empty: fabric by the yard, as before.
  defaultKind   String?

  orders PurchaseOrder[]

  @@unique([shopId, name])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PoUnit {
  YD
  BOLT
  EACH // any item that isn't sold by the yard (shop-features-round-2-design.md 1.1)
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  shopId          String
  shop            Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId      String?
  number          Int
  supplierId      String
  supplier        FabricSupplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierName    String
  status          PurchaseOrderStatus @default(DRAFT)
  note            String?
  createdAt       DateTime            @default(now())
  sentAt          DateTime?
  firstReceivedAt DateTime?
  receivedAt      DateTime?
  cancelledAt     DateTime?
  // How it went to the supplier: smtp (sent from the shop's own mail account), mailto (the shop's mail program), file
  // (the cart-upload spreadsheet), none (printed or by phone).
  sentVia         String?

  lines PurchaseOrderLine[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, locationId])
}

// One line: the item (kept by number and description too, so the order reads right if the item is changed), the amount
// in yards or bolts for fabric (a bolt is boltYards, copied when the line is made) or in pieces (EACH) for anything else,
// the maker's item number and the cost a yard or each. receivedYards is what came in, in the line's own measure: yards
// for fabric, pieces for an EACH line (the name is from when orders were fabric only).
model PurchaseOrderLine {
  id            String        @id @default(cuid())
  shopId        String
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // How many of the line are for each store when the order is for several (7.3): { locationId: qty }; {} = all for the order's store
  split         Json          @default("{}")
  orderId       String
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId        String?
  part          Part?         @relation(fields: [partId], references: [id], onDelete: SetNull)
  itemNumber    String
  description   String
  unit          PoUnit        @default(YD)
  qty           Float
  boltYards     Float         @default(15)
  costCents     Int?
  receivedYards Float         @default(0)
  // The supplier says it's back ordered (shop-features-round-2-design.md 4.4): when the shop marked it, and the day it is
  // expected (YYYY-MM-DD, the shop's zone; null: not known). Cleared when it comes or the shop takes the mark off.
  backorderedOn DateTime?
  expectedOn    String?

  @@index([orderId])
  @@index([shopId, partId])
}

// Kits (fabric-smarts-design.md section 4, package F4). A kit is a recipe: fabric cuts and notions (KitLine), a pattern (a
// PATTERN item that comes out of stock with each kit, or a note of where it comes from and what it costs), and a price.
// Its own stock item (partId) is what sells at the register and online; "Make N kits" takes the lines off the shelf and
// adds N to it. patternPartId is a plain id (no foreign key, like the fabric links on Part): kits.ts checks it is the
// company's own item before using it.
model Kit {
  id               String     @id @default(cuid())
  shopId           String
  shop             Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name             String
  note             String?
  patternPartId    String?
  patternNote      String?
  patternCostCents Int        @default(0)
  priceCents       Int?
  partId           String?
  part             Part?      @relation("KitStock", fields: [partId], references: [id], onDelete: SetNull)
  seriesId         String?
  series           KitSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesMonth      Int?
  handoutDoneAt    DateTime?
  createdAt        DateTime   @default(now())

  lines KitLine[]

  @@unique([seriesId, seriesMonth])
  @@index([shopId])
}

// One line of a kit: a fabric (yards, eighths) or a notion (units) and how much of it goes in one kit.
model KitLine {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kitId  String
  kit    Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
  partId String
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  qty    Float

  @@unique([kitId, partId])
  @@index([shopId, partId])
}

// Block of the Month: a series of up to 12 kits, one a month, with a sign-up roster of the shop's customers.
model KitSeries {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  months    Int      @default(12)
  note      String?
  createdAt DateTime @default(now())

  kits    Kit[]
  members KitSeriesMember[]
  clubs   Club[]

  @@index([shopId])
}

model KitSeriesMember {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seriesId   String
  series     KitSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note       String?
  signedUpAt DateTime  @default(now())

  @@unique([seriesId, customerId])
  @@index([shopId])
}

// Clubs (fabric-smarts-design.md section 4a, package F7): a fat quarter club, a fabric club or a Block of the Month
// (linked to a KitSeries) with a monthly price. A member is a customer with a status (active, paused, cancelled), ship
// or pick up, and how they pay: a card on the shop's own Stripe (a Stripe Customer and a monthly Subscription made with
// the shop's keys; webhooks say paid, failed or cancelled) or "pay at pickup", marked by hand each month. A month's
// pick list is who gets what, shipped or picked up, marked done. paidMonth is the last month paid ("2026-10").
enum ClubKind {
  FAT_QUARTER
  FABRIC
  BOM
  OTHER
}

enum ClubMemberStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum ClubFulfil {
  PICKUP
  SHIP
}

enum ClubBilling {
  STRIPE
  PAY_AT_PICKUP
}

model Club {
  id           String     @id @default(cuid())
  shopId       String
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  kind         ClubKind   @default(FAT_QUARTER)
  monthlyCents Int
  fulfil       ClubFulfil @default(PICKUP)
  billDay      Int?
  seriesId     String?
  series       KitSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  note         String?
  closedAt     DateTime?
  createdAt    DateTime   @default(now())

  members ClubMember[]
  months  ClubMonth[]
  picks   ClubPick[]

  @@index([shopId])
}

model ClubMember {
  id                   String           @id @default(cuid())
  shopId               String
  shop                 Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clubId               String
  club                 Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status               ClubMemberStatus @default(ACTIVE)
  fulfil               ClubFulfil       @default(PICKUP)
  billing              ClubBilling      @default(PAY_AT_PICKUP)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  paidMonth            String?
  lastPaidAt           DateTime?
  payFailedAt          DateTime?
  note                 String?
  joinedAt             DateTime         @default(now())
  pausedAt             DateTime?
  cancelledAt          DateTime?

  picks    ClubPick[]
  payments ClubPayment[]

  @@unique([clubId, customerId])
  @@index([shopId, clubId, status])
  @@index([shopId, stripeSubscriptionId])
}

// What the club gives this month (month = "2026-10"), and optionally the kit it is.
model ClubMonth {
  id     String  @id @default(cuid())
  shopId String
  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clubId String
  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  month  String
  what   String
  kitId  String?

  @@unique([clubId, month])
  @@index([shopId])
}

// A paid club month, as the books have it: the register sale it posted (a plain id: the sale stays in the books when the
// member goes), what was paid with tax included, how, and the Stripe invoice (or checkout) that paid it, which makes a
// retried webhook post nothing twice. voidedAt: refunded or taken back (the sale was voided).
model ClubPayment {
  id            String     @id @default(cuid())
  shopId        String
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  memberId      String
  member        ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month         String
  amountCents   Int
  method        String // CASH | CARD | CHECK | OTHER
  invoiceId     String?
  paymentIntent String?
  saleId        String
  voidedAt      DateTime?
  createdAt     DateTime   @default(now())

  @@unique([shopId, invoiceId])
  @@unique([shopId, saleId])
  @@index([shopId, memberId, month])
  @@index([shopId, paymentIntent])
}

// One member's share of a month: made when the pick list is opened, done when handed over or shipped.
model ClubPick {
  id         String      @id @default(cuid())
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clubId     String
  club       Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId   String
  member     ClubMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month      String
  doneAt     DateTime?
  doneFulfil ClubFulfil?
  tracking   String?

  @@unique([memberId, month])
  @@index([shopId, clubId, month])
}

// Longarm quilting (fabric-smarts-design.md 4a, F7): a quilting work order. Its own table, not a repair ticket: a ticket is
// a machine's repair (a machine row it can't exist without, the bench's statuses, tension readings and parts), and a quilt
// is none of those. Statuses: received, on the frame, ready, collected (or cancelled). Size in whole inches; the quilting
// price is size x rate (the rate in tenths of a cent per square inch: 2.5 cents is 25) or one flat price, plus thread,
// batting and extras; all integer cents. saleId: the register sale that billed it at collection (a plain id).
enum LongarmStatus {
  RECEIVED
  ON_FRAME
  READY
  COLLECTED
  CANCELLED
}

enum LongarmPricing {
  PER_SQIN
  FLAT
}

enum LongarmDesign {
  PANTOGRAPH
  CUSTOM
}

model LongarmOrder {
  id             String         @id @default(cuid())
  shopId         String
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId     String?
  number         Int
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name           String // who it is for, as taken in
  status         LongarmStatus  @default(RECEIVED)
  widthIn        Int
  lengthIn       Int
  pricing        LongarmPricing @default(PER_SQIN)
  rateTenthCents Int            @default(0)
  flatCents      Int            @default(0)
  design         LongarmDesign  @default(PANTOGRAPH)
  designName     String?
  thread         String?
  threadCents    Int            @default(0)
  batting        String?
  battingCents   Int            @default(0)
  extraCents     Int            @default(0)
  extraNote      String?
  quiltCents     Int // the quilting itself: size x rate, or the flat price
  totalCents     Int // quilting plus thread, batting and extras, before tax
  taxable        Boolean        @default(true)
  dueAt          DateTime?
  note           String?
  receivedAt     DateTime       @default(now())
  onFrameAt      DateTime?
  readyAt        DateTime?
  collectedAt    DateTime?
  saleId         String?
  createdById    String?
  createdAt      DateTime       @default(now())

  photos LongarmPhoto[]

  @@unique([shopId, number])
  @@index([shopId, status, dueAt])
  @@index([shopId, customerId])
  @@index([shopId, locationId])
}

model LongarmPhoto {
  id        String       @id @default(cuid())
  shopId    String
  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId   String
  order     LongarmOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  caption   String?
  createdAt DateTime     @default(now())

  @@index([shopId, orderId])
}

// ============================================================
// The Assistant add-on (docs/plans/ai-assistant-scope.md). Nothing here is called on its own: a person presses a button.
// ============================================================

// A company's Assistant settings (Settings -> Assistant): a switch per feature group, the shop's voice sample, and the
// consent switch for customers' first names in drafts (off: drafts carry {first_name}, filled in on this PC).
model AssistantSettings {
  shopId           String   @id
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  draftOn          Boolean  @default(true)
  causesOn         Boolean  @default(true)
  plateOn          Boolean  @default(true)
  manualsOn        Boolean  @default(true)
  partsOn          Boolean  @default(true)
  fabricOn         Boolean  @default(true)
  // Stock helpers (shop-features-round-2-design.md 1.10): a photo of the packing slip or invoice fills in receiving
  stockOn          Boolean  @default(true)
  // Phase 4 (shop-features-round-2-design.md section 5): Ask your shop, marketing drafts, the quilt planner's picks, and
  // customer answers on the booking page (off until the shop turns it on; typed questions at most customerDailyCap a day)
  askOn            Boolean  @default(true)
  marketingOn      Boolean  @default(true)
  quiltOn          Boolean  @default(true)
  customerOn       Boolean  @default(false)
  customerDailyCap Int      @default(20)
  offerFirstNames  Boolean  @default(false)
  voice            String?
  updatedAt        DateTime @updatedAt
}

// What the Assistant was asked and what it said, per company: the record a tech can check, and the month's count.
model AssistantCall {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  feature         String // draft_work_done | draft_diagnosis | draft_partner_note | draft_estimate | draft_ready | likely_causes | read_plate
  ticketId        String? // what it was about: at most one of these is set
  repairJobId     String?
  machineId       String?
  partId          String?
  purchaseOrderId String? // a packing slip or invoice read for this purchase order (1.10)
  byUserId        String?
  model           String // the model id the hub used
  request         Json // the redacted request exactly as sent: { system, messages, maxTokens } (a photo as its size and hash)
  response        String // the model's text, or the structured JSON as text; a serial masked as [serial]
  sources         Json     @default("[]") // [{ kind: ticket|gotcha|hubpost|spec|setting|servicemode|general, ref, label }]
  inputTokens     Int      @default(0)
  cacheTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  costMillicents  Int      @default(0) // thousandths of a cent: money stays an integer, and a call is under a cent
  ms              Int      @default(0)
  accepted        Boolean? // "Use this" pressed, or "helped"; null for calls that only showed something
  error           String?
  createdAt       DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, ticketId])
}

// Text pulled out of a library PDF so a company can search its manuals (Assistant: Ask the manuals). One row per page that
// has text, per company: the company chose to index (a button), and the text stays in this database; only the few
// matching pages of a question go to the model. A page with no text (a scan) has no row. `docId` is LibraryDoc.id (no
// relation: the library is this PC's, rebuilt on its own). Search is Postgres full text (a GIN index on
// to_tsvector('english', text), made in the migration: Prisma can't express it). Rebuildable, so it stays on the install.
model ManualPage {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  docId  String
  page   Int
  text   String

  @@unique([shopId, docId, page])
  @@index([shopId, docId])
}

// Where indexing stands for one library file of one company: the resume point (donePages) and what couldn't be read.
model ManualIndexDoc {
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  docId      String
  totalPages Int      @default(0)
  donePages  Int      @default(0)
  blankPages Int      @default(0) // pages with no text (scans): not searchable yet
  status     String   @default("queued") // queued | running | paused | done | failed
  error      String?
  updatedAt  DateTime @updatedAt

  @@id([shopId, docId])
  @@index([shopId, status])
}

// ============================================================
// Audit log (later-round-1-design.md section 4): who did what to money, stock, prices and people. Append-only: the
// database refuses UPDATE and DELETE (migration trigger) except in a transaction that says it is pruning
// (src/lib/audit.ts). No foreign keys: an entry outlives the login or record it names, with the name and label as they
// were.
// ============================================================
model AuditEntry {
  id           String   @id @default(cuid())
  shopId       String
  at           DateTime @default(now())
  userId       String?
  userName     String
  role         String?
  // user | platform-admin | customer | system
  actor        String   @default("user")
  category     String // money | prices | stock | deletes | settings | people | data
  action       String // "sale.void"
  subjectType  String
  subjectId    String?
  subjectLabel String?
  // { field: [before, after] }
  changes      Json?
  amountCents  Int?
  reason       String?
  ip           String?

  @@index([shopId, at])
  @@index([shopId, subjectType, subjectId])
}

// ============================================================
// Gift cards and store credit (later-round-1-design.md section 2). The ledger (GiftCardEntry) is the truth;
// balanceCents is its sum, kept in step in the same transaction (never below 0: a database check says so).
// ============================================================
model GiftCard {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Printed on the card: GC-XXXX-XXXX-XXXX-C, or a number from a pre-printed blank (6 to 24 letters and digits)
  number       String
  kind         String    @default("gift") // gift | credit
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  balanceCents Int       @default(0)
  status       String    @default("active") // active | void
  issuedAt     DateTime  @default(now())
  lastUsedAt   DateTime?
  note         String?
  createdById  String?

  entries GiftCardEntry[]

  @@unique([shopId, number])
  @@index([shopId, customerId])
}

model GiftCardEntry {
  id          String   @id @default(cuid())
  shopId      String
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId  String?
  cardId      String
  card        GiftCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  at          DateTime @default(now())
  // + onto the card, - off it
  amountCents Int
  // SOLD | LOADED | REDEEMED | REFUNDED_TO | CASHED_OUT | ADJUSTED | OPENING | VOID | MOVED
  reason      String
  // Plain ids of what caused it
  saleId      String?
  saleLineId  String?
  paymentId   String?
  ticketId    String?
  userId      String?
  note        String?

  @@index([cardId, at])
  @@index([shopId, at])
  @@index([saleId])
  @@index([paymentId])
  @@index([shopId, locationId])
}

// Machines for sale (tax-machine-sales-layaway-design.md section 3): a maker's warranty terms as the shop types them
// (no built-in claims about any maker), shown on the unit, the receipt and a ticket for a machine sold here. One row per
// brand; brandKey is the brand in lower case.
model MakerWarranty {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  brand            String
  brandKey         String
  partsYears       Float?
  laborYears       Float?
  electronicsYears Float?
  // The maker's warranty registration page
  registerUrl      String?
  note             String?
  updatedAt        DateTime @updatedAt

  @@unique([shopId, brandKey])
}

// The shop's own service plan: "Free cleaning yearly for 3 years" (3 visits in 36 months) or an extended warranty (no
// visit limit). Sold as a register line or included with a machine for sale; each sale makes a MachinePlan.
model ServicePlan {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Covered visits (repair tickets) in the term; null: no limit (an extended warranty)
  visits      Int?
  months      Int
  priceCents  Int      @default(0)
  taxable     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([shopId])
}

// A service plan on one machine: copied from the ServicePlan when sold (later changes to the plan don't touch it). A
// ticket's line covered by it points here (TicketLine.coveredPlanId); a visit is a ticket with a covered line.
model MachinePlan {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  planId      String? // the ServicePlan it came from (plain id)
  name        String
  visits      Int?
  startsAt    DateTime
  endsAt      DateTime
  // The register line that sold it, or the line that sold the machine it came with (plain ids)
  saleLineId  String?
  stockUnitId String?
  // Ended early: its sale was voided or the machine returned
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([shopId, machineId])
  @@index([saleLineId])
}

// Layaway (tax-machine-sales-layaway-design.md section 4): the items held for a customer while they pay over time. The
// money goes through the register (SaleLine.layawayId, kind LAYAWAY: money held for the customer, not a sale yet); the
// last visit sells the items at that day's tax and uses the payments up. A machine is HELD (StockUnit.layawayId), a
// stock item's quantity taken off the shelf (StockMove HELD) until then.
model Layaway {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId      String?
  number          Int
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          String        @default("OPEN") // OPEN | COMPLETED | CANCELLED
  startedAt       DateTime      @default(now())
  // The last day to pay (YYYY-MM-DD, shop's zone) and the payment plan: [{ due: "YYYY-MM-DD", cents }] after the deposit
  dueBy           String
  every           String        @default("2w")
  plan            Json          @default("[]")
  // The deposit taken at the start (the plan splits the rest)
  depositMinCents Int           @default(0)
  // The terms as printed for the customer to sign (kept as they were)
  terms           String
  note            String?
  // The pick-up sale, or the cancel's refund sale (plain ids)
  saleId          String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelFeeCents  Int?
  createdById     String?
  createdAt       DateTime      @default(now())
  lines           LayawayLine[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([customerId])
  @@index([shopId, locationId])
}

model LayawayLine {
  id             String  @id @default(cuid())
  layawayId      String
  layaway        Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  partId         String?
  stockUnitId    String?
  description    String
  partNumber     String?
  unit           String?
  qty            Float
  unitPriceCents Int
  discountCents  Int     @default(0)
  taxable        Boolean @default(true)

  @@index([layawayId])
}

// A sales tax holiday (tax-machine-sales-layaway-design.md section 1): whole days in the shop's zone (YYYY-MM-DD), the
// kinds of item it covers (sale line kinds: FABRIC, NOTION, UNIT...), and a per-item limit: a line whose price each,
// after its own discount, is over it is taxed in full. The register applies it by date; preset: the state it was
// filled in from ("MA"), for the yearly "confirm the dates" reminder.
model TaxHoliday {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  preset       String?
  firstDay     String
  lastDay      String
  kinds        String[]
  maxUnitCents Int?
  // The stores it covers (Location ids); empty = every store (a preset fills in the stores in its state)
  locationIds  String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([shopId, firstDay])
}

// Financing (tax-machine-sales-layaway-design.md section 5, owner's answer 7: record only): a lender the shop offers
// (Synchrony, Affirm...), with its "apply now" page. Taken at the register as the Financing payment method.
model Lender {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  applyUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  financed FinancedSale[]

  @@index([shopId])
}

// One Financing payment on a register sale: the lender owes the shop this much until the shop marks it paid (the books
// carry it as owed by lenders). A refund through the lender is a negative one. Voided with its sale.
model FinancedSale {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  saleId      String // plain id of the Sale
  lenderId    String
  lender      Lender    @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  amountCents Int
  approval    String?
  at          DateTime  @default(now())
  paidAt      DateTime?
  paidById    String?
  voidedAt    DateTime?

  @@index([shopId, paidAt])
  @@index([saleId])
  @@index([lenderId])
}

// A promotion (tax-machine-sales-layaway-design.md section 2): whole days in the shop's zone, what it covers (scope:
// { kinds: [...], brands: [...], partIds: [...] }, any of them), and one effect: PERCENT off (value: the percent),
// AMOUNT off each (value: cents), or TAX_INCLUDED (the price includes the tax, backed out at the shop's rate; only
// while Shop.taxIncludedOn). The register applies it by date as the line's own discount.
model Promotion {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  firstDay  String
  lastDay   String
  scope     Json     @default("{}")
  effect    String
  value     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([shopId, firstDay])
}

// A pattern's yardage per size and role, typed once from the back of the pattern (shop-features-round-2-design.md 5.3):
// "Throw: background 2 1/4 yd". patternPartId is a plain id of this company's PATTERN item (no foreign key, so a company
// file imports in any order); src/lib/quilt.ts reads only the company's own.
model PatternNeed {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  patternPartId String
  size          String
  role          String
  yards         Float
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([shopId, patternPartId])
}

// The shop's own care tips per kind of machine (5.5): the pickup sheet picks from these; the model never writes advice.
model CareTip {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind      String // sewing | vacuum | a shop kind's key
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([shopId, kind])
}

// A customer's question from the public page that goes to a person (5.6): her name and contact as she typed them, and
// when staff dealt with it.
model CustomerQuestion {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  at        DateTime  @default(now())
  name      String?
  contact   String?
  text      String
  handledAt DateTime?
  handledBy String?

  @@index([shopId, handledAt])
}

// "Raise prices" (shop-features-round-2-design.md 4.4): one raise as the shop chose it (rule: whose, by how much, how
// rounded) and every item it changed with the old and new price, so "Undo" (for a day) puts back what it raised.
model PriceChange {
  id       String    @id @default(cuid())
  shopId   String
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  at       DateTime  @default(now())
  userId   String?
  rule     Json
  items    Json // [{ partId, oldCents, newCents }]
  undoneAt DateTime?

  @@index([shopId, at])
}

// A live sale (shop-features-round-2-design.md 4.3): a Facebook Live or similar show. The shop picks what's on today's
// show beforehand (picks: plain part ids), claims each buyer's items as they're called out, and at the end sends each
// buyer one pay link for her claims. status OPEN | CLOSED; holdHours: unpaid claims after this show "Let go of these?".
model LiveSale {
  id          String      @id @default(cuid())
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId  String?
  name        String
  startsAt    DateTime    @default(now())
  status      String      @default("OPEN")
  holdHours   Int         @default(48)
  picks       String[]    @default([])
  createdById String?
  createdAt   DateTime    @default(now())
  closedAt    DateTime?
  claims      LiveClaim[]

  @@index([shopId, startsAt])
  @@index([shopId, locationId])
}

// One buyer's claim on a live sale: the item (plain part id), how much (yards in eighths for fabric), the price, and
// where it stands: HELD (the stock is held for her), SENT (in her pay link, webOrderId), PAID, LET_GO (back on the shelf).
// customerId is a plain id (a new name is fine: the customer is made when the pay link is sent).
model LiveClaim {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  liveSaleId  String
  liveSale    LiveSale  @relation(fields: [liveSaleId], references: [id], onDelete: Cascade)
  customerId  String?
  name        String
  phone       String?
  partId      String?
  description String
  qty         Float
  unit        String?
  priceCents  Int
  status      String    @default("HELD")
  webOrderId  String?
  createdById String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  paidAt      DateTime?
  letGoAt     DateTime?

  @@index([liveSaleId, status])
  @@index([shopId, status, partId])
}

// A payment toward an event sign-up (shop-features-round-2-design.md 4.5): a deposit or the balance, taken at the counter
// (a register sale, saleId) or by a pay link (webOrderId; paidAt is set when she pays). kind DEPOSIT | BALANCE | PAYMENT.
model EventPayment {
  id           String     @id @default(cuid())
  shopId       String
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  kind         String     @default("PAYMENT")
  amountCents  Int
  saleId       String?
  webOrderId   String?
  paidAt       DateTime?
  cancelledAt  DateTime?
  createdById  String?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId])
  @@index([shopId, webOrderId])
}

// A door prize drawn at an event (4.5): who, for which prize, and whether she was there (a draw again keeps the first,
// marked not present).
model EventDraw {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  classId      String
  shopClass    ShopClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollmentId String
  name         String
  prize        String
  drawnAt      DateTime  @default(now())
  present      Boolean   @default(true)

  @@index([classId, drawnAt])
}

// A shop hop this shop takes part in (shop-features-round-2-design.md 4.6), as the hub last told it: the hub's id, the
// name and dates (YYYY-MM-DD), the prize rule ("all", or "any:6"), how many shops, and this shop's part: ORGANIZER or
// MEMBER, status JOINED | LEFT. The hub holds the hop, its shops, passports and stamps.
model ShopHop {
  id         String          @id @default(cuid())
  shopId     String
  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  hubHopId   String
  name       String
  startsOn   String?
  endsOn     String?
  rule       String          @default("all")
  shopsCount Int             @default(1)
  role       String          @default("MEMBER")
  status     String          @default("JOINED")
  slug       String?
  updatedAt  DateTime        @updatedAt
  createdAt  DateTime        @default(now())
  stamps     HopStampLocal[]

  @@unique([shopId, hubHopId])
}

// A passport stamped at this shop (4.6): the shop's own record, sent to the hub signed (sentAt when the hub took it).
// One per passport per hop. What the hub answered: the stamp's number of how many, and the shopper's details only if she
// chose to share them with this shop.
model HopStampLocal {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  hopId        String
  hop          ShopHop   @relation(fields: [hopId], references: [id], onDelete: Cascade)
  passportRef  String
  at           DateTime  @default(now())
  byUserId     String?
  sentAt       DateTime?
  stampNo      Int?
  stampsOf     Int?
  complete     Boolean   @default(false)
  shopperName  String?
  shopperEmail String?
  shopperPhone String?
  error        String?

  @@unique([hopId, passportRef])
  @@index([shopId, at])
}

// Special orders and pre-orders (shop-features-round-2-design.md 1.2): something a customer wants that isn't on the
// shelf (an item of the shop's, or words: "Tula Pink Untamed charm pack"), at a price, with a deposit. A pre-order is the
// same for an item marked coming soon (Part.comingSoonOn). Money goes through the register (SaleLine.specialOrderId,
// kind DEPOSIT: held for the customer, not a sale yet); the pick-up sells the item and uses the deposits up. When it
// arrives it is HERE: an item's quantity is held off the shelf for her (StockMove HELD, heldQty) until she picks it up.
// WAITING (not ordered yet) | ORDERED (on a purchase order) | HERE | DONE (picked up) | CANCELLED.
model SpecialOrder {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId   String?
  number       Int
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  kind         String    @default("ORDER") // ORDER | PREORDER
  status       String    @default("WAITING")
  partId       String? // plain id: the shop's item, when it is one
  description  String
  qty          Float     @default(1)
  unit         String?
  priceCents   Int // each
  depositCents Int       @default(0) // asked when taken
  depositRule  String    @default("credit") // credit | refund | keep (non-refundable)
  expectedOn   String? // YYYY-MM-DD
  poLineId     String? // the purchase order line that covers it (plain id)
  heldQty      Float     @default(0)
  hereAt       DateTime?
  noticedAt    DateTime? // the "it's here" message queued (never twice)
  calledAt     DateTime? // marked called by hand
  saleId       String? // the pick-up sale, or the cancel's (plain ids)
  prevStatus   String? // the status before a cancel, put back when the cancel is undone
  cancelledAt  DateTime?
  note         String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, partId])
  @@index([customerId])
  @@index([shopId, locationId])
}

// Want lists (shop-features-round-2-design.md 1.4): what a customer wants the shop to tell her about, an item of the
// shop's or words to watch for ("Tula Pink"). When an item that matches arrives (received, imported from a supplier's
// list, added) the line shows "Here now" (matchedPartId, plain id); the shop chooses to tell her (toldAt, the order_in
// message), nothing goes by itself. doneAt: taken off the list.
model WantItem {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  partId        String? // plain id
  words         String?
  note          String?
  matchedPartId String?
  matchedAt     DateTime?
  toldAt        DateTime?
  doneAt        DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([shopId, doneAt])
  @@index([customerId])
}

// Customer price groups and memberships (shop-features-round-2-design.md 1.5): "Guild", "Teachers", "Club card",
// "Wholesale". What it gives: a percent off, or the item's wholesale price; on which kinds of items (none listed: all);
// and whether it also applies to items already on sale (a promotion on the same line: the bigger one wins, not both).
model PriceGroup {
  id           String     @id @default(cuid())
  shopId       String
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  pctOff       Int        @default(0)
  useWholesale Boolean    @default(false)
  kinds        String[]   @default([])
  onSaleItems  Boolean    @default(false)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  customers    Customer[]

  @@index([shopId])
}

// Per-yard price breaks (shop-features-round-2-design.md 1.6): "10 yards or more of one fabric: 10% off", one or more
// steps, on some kinds (none listed: every item sold by the yard). An item may have its own (Part.breakMinQty).
model YardBreak {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  minYards  Float
  pctOff    Int
  kinds     String[] @default([])
  createdAt DateTime @default(now())

  @@index([shopId])
}

// A machine lent out (shop-features-round-2-design.md 1.7): a loaner while hers is in for repair, a demo taken to a class,
// a show or a home. The unit is one of the shop's machines (StockUnit with use LOANER or DEMO); out until backAt. A deposit
// is money held for the customer (SaleLine.unitLoanId, kind DEPOSIT) until it is refunded or kept (LOAN_FEE, "Loaner
// charges").
model UnitLoan {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId    String?
  unitId        String // plain id (StockUnit)
  kind          String    @default("LOAN") // LOAN | DEMO | RENTAL
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticketId      String? // plain id: the repair ticket it was lent on
  outAt         DateTime  @default(now())
  dueOn         String? // YYYY-MM-DD
  backAt        DateTime?
  depositCents  Int       @default(0)
  cardNote      String?
  // A rental (1.8): the rate (cents a day, week or month), and rent-to-own: the percent of the rent paid that counts
  // toward buying it, until a day (YYYY-MM-DD)
  rateCents     Int?
  ratePer       String? // day | week | month
  ownPct        Int?
  ownUntil      String?
  conditionOut  String?
  conditionBack String?
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([shopId, backAt])
  @@index([unitId])
  @@index([customerId])
  @@index([shopId, locationId])
}

// Trade-up credit used (shop-features-round-2-design.md 1.9): a repair's cost taken off a machine bought within the shop's
// days. The offer itself is worked out from the ticket (its charges, the day it was done); this row is written when the
// credit is used on a sale (once per ticket), so a void deletes it and the credit is there again.
model TradeUpOffer {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticketId    String // plain id
  amountCents Int
  until       String // YYYY-MM-DD
  usedLineId  String // the sale line it came off (plain id)
  createdAt   DateTime  @default(now())

  @@unique([shopId, ticketId])
  @@index([usedLineId])
}

// A warranty claim to a machine's maker (shop-features-round-2-design.md 9.1, package warranty-claims): the ticket's
// lines marked "Claim it from the maker" (TicketLine.claimId) charge the customer nothing and go on it. Logged and
// reconciled here; the makers' own portals are never connected. status: OPEN (being put together) | FILED (sent) |
// PAID | SHORT (paid less than expected) | REFUSED. partsCents and laborCents add up the claimed lines; expectedCents is
// what the maker should pay (fixed once filed; owed by the maker in the books from filedAt); receivedCents came in on
// receivedAt (also the day a refused or short claim is closed). ticketId and machineId are plain ids.
model WarrantyClaim {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  number        Int
  ticketId      String?
  machineId     String?
  maker         String
  claimNumber   String?
  status        String    @default("OPEN")
  filedAt       DateTime?
  partsCents    Int       @default(0)
  laborCents    Int       @default(0)
  expectedCents Int       @default(0)
  receivedCents Int       @default(0)
  receivedAt    DateTime?
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, ticketId])
}

// A co-op advertising or rebate claim to a maker (shop-features-round-2-design.md 9.2, package coop-claims): what the
// shop spent (an ad placed, or machines sold under a rebate program), what it can claim back, the program's deadline
// (a dashboard line 14 days before, while not sent), sent, and what came in. kind: COOP | REBATE; status: OPEN (not
// sent) | FILED | PAID | SHORT | DENIED. placedOn and deadline are the shop's days (YYYY-MM-DD). The proof (a photo of
// the ad, the invoice) is CoopProof.
model CoopClaim {
  id            String      @id @default(cuid())
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  number        Int
  maker         String
  kind          String      @default("COOP")
  program       String?
  adWhere       String?
  placedOn      String?
  spentCents    Int         @default(0)
  claimCents    Int         @default(0)
  deadline      String?
  status        String      @default("OPEN")
  filedAt       DateTime?
  receivedCents Int         @default(0)
  receivedAt    DateTime?
  note          String?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  proofs        CoopProof[]

  @@unique([shopId, number])
  @@index([shopId, status, deadline])
}

// A photo or PDF proving a co-op claim (the ad as it ran, the invoice for it), 5 MB at most.
model CoopProof {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  claimId   String
  claim     CoopClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  data      Bytes
  createdAt DateTime  @default(now())

  @@index([claimId])
}

// What the shop owes a consignor for her machine sold on consignment (shop-features-round-2-design.md 9.6, package
// consign-machines): written when the machine sells (amountCents: what it sold for before tax, less the shop's
// commission), paid by check, cash or store credit (paidAt, method, note: the check number), voided with the sale or a
// return before it was paid. unitId, customerId, saleLineId and giftCardId are plain ids. In the books it is owed to
// consignors (a liability) from the sale until it is paid.
model ConsignPayout {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  unitId      String
  customerId  String
  saleLineId  String
  soldCents   Int
  pct         Float
  amountCents Int
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  method      String? // CHECK | CASH | CREDIT
  note        String?
  giftCardId  String?
  paidById    String?
  voidedAt    DateTime?

  @@index([shopId, customerId])
  @@index([shopId, paidAt])
  @@index([saleLineId])
}

// A quilt appraisal (shop-features-round-2-design.md 9.8, package appraisals): the customer, the quilt (details:
// { title, widthIn, lengthIn, maker, made, techniques, materials, condition, description }), the value and its purpose
// (insurance replacement | fair market | donation), the appraiser and her credential as on the certificate, the fee
// rung up at the register (saleId, plain), and issuedAt once the certificate is final (it can't be changed after; a
// new appraisal replaces it). customerId is plain.
model Appraisal {
  id          String           @id @default(cuid())
  shopId      String
  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  number      Int
  customerId  String?
  name        String
  details     Json             @default("{}")
  valueCents  Int              @default(0)
  purpose     String           @default("insurance")
  appraiser   String?
  credential  String?
  feeCents    Int              @default(0)
  saleId      String?
  issuedAt    DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  photos      AppraisalPhoto[]

  @@unique([shopId, number])
  @@index([shopId, customerId])
}

// A photo of the appraised quilt (the first prints on the certificate), 5 MB at most.
model AppraisalPhoto {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appraisalId String
  appraisal   Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  mime        String
  data        Bytes
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([appraisalId])
}

// A customer's wish list or gift registry (shop-features-round-2-design.md 9.9, package gift-registry): what she would
// like, shared by a link she sends to family (token, on the shop's public page). Bought at the counter it is ticked off
// (SaleLine.registryItemId) without telling her. customerId is plain. closedAt: no longer shared.
model GiftRegistry {
  id         String         @id @default(cuid())
  shopId     String
  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  name       String
  title      String
  eventDate  String?
  token      String         @unique
  closedAt   DateTime?
  createdAt  DateTime       @default(now())
  items      RegistryItem[]

  @@index([shopId, customerId])
}

// One thing on a gift list: an item from stock (partId, plain) or words, and how many she would like.
model RegistryItem {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  registryId  String
  registry    GiftRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)
  partId      String?
  description String
  qtyWanted   Int          @default(1)
  note        String?
  createdAt   DateTime     @default(now())

  @@index([registryId])
}

// A customer's house charge account (shop-features-round-2-design.md 9.4, package house-accounts): she buys "on account"
// at the register (tender ACCOUNT) or on a ticket (payment INVOICE), up to her limit (0: no limit), and pays within the
// terms (days) from a monthly statement. status: OPEN | CLOSED (no new charges). Only while Shop.houseAccountsOn.
model HouseAccount {
  id         String         @id @default(cuid())
  shopId     String
  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  limitCents Int            @default(0)
  termsDays  Int            @default(30)
  status     String         @default("OPEN")
  note       String?
  createdAt  DateTime       @default(now())
  entries    AccountEntry[]

  @@unique([shopId, customerId])
}

// One charge or payment on a house account: kind CHARGE (a sale or a ticket put on account; negative for a refund to the
// account) | PAYMENT (money she paid against it: method CASH | CHECK | CARD | OTHER, note the check number) | ADJUST.
// saleId, ticketId and paymentId (a ticket's Payment) are plain. voidedAt: the sale was voided (or the payment undone).
model AccountEntry {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId  String?
  accountId   String
  account     HouseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        String
  amountCents Int
  method      String?
  note        String?
  saleId      String?
  ticketId    String?
  paymentId   String?
  byUserId    String?
  at          DateTime     @default(now())
  voidedAt    DateTime?

  @@index([accountId, at])
  @@index([shopId, at])
  @@index([saleId])
  @@index([shopId, locationId])
}

// A Stripe Terminal card reader paired to the shop (shop-features-round-2-design.md 4.8, package card-reader): Stripe's
// reader id (tmr_...), the shop's name for it, and its kind (a simulated reader in test mode).
model CardReader {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The store it belongs to (shop-features-round-2-design.md 7.1): a plain Location id; null = the main store
  locationId String?
  readerId   String
  label      String
  deviceType String?
  createdAt  DateTime @default(now())

  @@unique([shopId, readerId])
  @@index([shopId, locationId])
}

// A card payment taken on the reader (4.8): the PaymentIntent (pi_...), how much, where it stands (PENDING | SUCCEEDED |
// FAILED | CANCELLED), the card's last four, the sale it paid (saleId, plain; null while on no sale yet), and what has
// been refunded to the card since.
model CardPayment {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  intentId      String   @unique
  readerId      String?
  amountCents   Int
  status        String   @default("PENDING")
  last4         String?
  brand         String?
  saleId        String?
  refundedCents Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId, saleId])
  @@index([shopId, status])
}

// ============================================================
// More than one store (shop-features-round-2-design.md section 7, phase 5)
// ============================================================

// A store of the company (7.1). The main store (main = true; the migration makes one per company from its own details,
// and a company without one gets it when a second store is added) keeps its address, phone, time zone, tax rate and
// receipt line on the Shop row as before, so a company with one store works exactly as it did; another store keeps its
// own here. Rows whose locationId is null belong to the main store. A store is closed (active = false), never deleted;
// the main store can't be closed. approveRefundCents / approveDiscountPct (7.5): a refund over the amount, or a discount
// over the percent, needs a manager's code or the owner's approval; null = no limit. dailyAt: the store's closing time
// ("HH:MM", the daily summary goes then; null = 18:00).
model Location {
  id                 String   @id @default(cuid())
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  main               Boolean  @default(false)
  address            String?
  phone              String?
  timeZone           String   @default("America/New_York")
  taxRatePct         Float    @default(0)
  // Wrong approval codes typed at this store's register (counted before each try), and the 15 minutes' wait after five
  approveFails       Int      @default(0)
  approveLockedUntil DateTime?
  hours              String?
  receiptFooter      String?
  dailyAt            String?
  approveRefundCents Int?
  approveDiscountPct Int?
  // Google's local inventory feed: the store's Business Profile store code (the main store's is Shop.feedStoreCode)
  feedStoreCode      String?
  // The owner's daily summary (7.5): the store's day it was last sent for (YYYY-MM-DD in the store's zone), never twice
  dailySentOn        String?
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  levels StockLevel[]

  @@index([shopId, sortOrder])
}

// An item's stock at a store other than the main one (7.2). The main store's stock is Part.qtyOnHand less every other
// store's level, so Part.qtyOnHand stays the company's total (kept in the same transaction) and every reader that wants
// the total keeps working; bin and reorder point here are the store's own (the main store's are Part.location and
// Part.reorderAt). A store with no row has none.
model StockLevel {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  qtyOnHand  Float    @default(0)
  reorderAt  Float    @default(0)
  bin        String?
  updatedAt  DateTime @updatedAt

  @@unique([partId, locationId])
  @@index([shopId, locationId])
}

// Stock sent from one store to another, or asked for (7.2, 7.3, 7.7). status: ASKED (a request; the other store sends
// it or says it can't, with a reason) | SENT (off the sending store's shelf, on its way) | ARRIVED (on the receiving
// store's shelf; counts corrected on arrival are recorded there as an adjustment) | CANCELLED | DECLINED. forCustomerId:
// brought over for a customer (her "it's here" message goes when it arrives); saleId: the sale it was paid on;
// specialOrderId: the special order holding it; poId: a purchase order's share for this store. fromId / toId are
// Location ids. The user ids and the parties' ids are plain.
model StockTransfer {
  id             String              @id @default(cuid())
  shopId         String
  shop           Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  number         Int
  fromId         String
  toId           String
  status         String              @default("SENT")
  note           String?
  neededBy       String?
  declineReason  String?
  forCustomerId  String?
  saleId         String?
  specialOrderId String?
  poId           String?
  askedById      String?
  askedAt        DateTime?
  sentById       String?
  sentAt         DateTime?
  arrivedById    String?
  arrivedAt      DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime            @default(now())
  lines          StockTransferLine[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, toId, status])
}

// One item of a transfer: a stocked item (partId) and how many were asked for, sent and counted on arrival, or a machine
// for sale (unitId, plain StockUnit id; qty 1).
model StockTransferLine {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  partId      String?
  part        Part?         @relation(fields: [partId], references: [id], onDelete: SetNull)
  unitId      String?
  description String
  qty         Float
  qtySent     Float?
  qtyArrived  Float?

  @@index([transferId])
}

// Notes between stores (7.7): to one store (toLocationId) or all (null); pinned notes first. fromLocationId and userId
// are plain ids (the writer and her store).
model StoreNote {
  id             String          @id @default(cuid())
  shopId         String
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fromLocationId String?
  toLocationId   String?
  userId         String?
  text           String
  pinned         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  reads          StoreNoteRead[]

  @@index([shopId, createdAt])
}

model StoreNoteRead {
  noteId String
  note   StoreNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime  @default(now())

  @@id([noteId, userId])
}

// A refund or discount over the store's limit, waiting for the owner (7.5): kind REFUND | DISCOUNT; amountCents (the
// refund, or the discount in money) and pct (a discount's percent); draft: what the register needs to carry on (its
// lines, for the owner to see); status ASKED | APPROVED | REFUSED | EXPIRED | USED (the register used an approval).
// A manager's code at the register approves at once (decidedById: the manager). Ids are plain.
model Approval {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  locationId    String?
  kind          String
  amountCents   Int
  pct           Float?
  reason        String?
  draft         Json      @default("{}")
  requestedById String?
  status        String    @default("ASKED")
  decidedById   String?
  decidedAt     DateTime?
  note          String?
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([shopId, status])
}

// A packing slip received through the slip reader (round-2 3.x): its key, made once per reading, so "Receive these"
// sent again (a retry, a double tap) receives nothing twice
model SlipReceipt {
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  key       String
  words     String?
  createdAt DateTime @default(now())

  @@id([shopId, key])
}
